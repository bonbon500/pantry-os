        }
        lines {
          text: "      if (!trimmed || trimmed.includes(\'\327\241\327\224\327\264\327\233\') || trimmed.includes(\'\327\236\327\242\327\264\327\236\') || trimmed.includes(\'\327\220\327\251\327\250\327\220\327\231\') || trimmed.includes(\'\327\251\327\247\327\231\327\225\327\252 \327\222\327\225\327\244\327\231\327\224\') || trimmed.includes(\'\327\244\327\231\327\247\327\223\327\225\327\237\')) {"
