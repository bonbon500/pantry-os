233\327\225\327\233\327\231\327\252 / \327\246\327\240\327\246\327\240\327\225\327\252\',\n  },\n  CANNED_COLUMN_2: {\n    type: \'CANNED_COLUMN_2\',\n    nameHe: \'\327\236\327\223\327\244\327\231 \327\251\327\231\327\236\327\225\327\250\327\231\327\235 \327\225\327\250\327\230\327\221\327\231\327\235 (\327\242\327\236\327\225\327\223\327\224 2)\',\n    shortName: \'\327\251\327\231\327\236\327\225\327\250\327\231\327\235 \327\225\327\250\327\230\327\221\327\231\327\235\',\n    descriptionHe: \'\327\251\327\231\327\236\327\225\327\250\327\231\327\235, \327\250\327\230\327\221\327\231\327\235, \327\236\327\236\327\250\327\227\327\231\327\235, \327\221\327\247\327\221\327\225\327\247\327\231 \327\251\327\236\327\237 \327\247\327\230\327\240\327\231\327\235 (\327\236\327\223\327\244\327\231\327\235 \327\220\327\225\327\244\327\247\327\231\327\231\327\235 \327\236\327\223\327\225\327\250\327\222\327\231\327\235)\',\n    iconName: \'Package\',\n    colorBg: \'bg-rose-500/10\',\n    colorBorder: \'border-rose-500/30\',\n    colorAccent: \'text-rose-700 dark:text-rose-400\',\n    badge: \'CAN-COL-2\',\n    storageType: \'\327\236\327\223\327\243 \327\251\327\231\327\236\327\225\327\250\327\231\327\235\',\n  },\n  KANBAN_BACKUP_3: {\n    type: \'KANBAN_BACKUP_3\',\n    nameHe: \'\327\250\327\226\327\250\327\221\327\225\327\252 \327\225\327\236\327\220\327\250\327\226\327\231 \327\222\327\231\327\221\327\225\327\231 (\327\247\327\240\327\221\327\237 \327\242\327\234\327\231\327\225\327\237)\',\n    shortName: \'\327\250\327\226\327\250\327\221\327\225\327\252 \327\247\327\240\327\221\327\237\',\n    descriptionHe: \'\327\236\327\220\327\250\327\226\327\231\327\235 \327\233\327\244\327\225\327\234\327\231\327\235, \327\251\327\231\327\251\327\231\327\225\327\252 \327\251\327\252\327\231\327\231\327\224, \327\250\327\226\327\250\327\221\327\224 (\327\236\327\223\327\243 \327\242\327\234\327\231\327\225\327\237/\327\220\327\227\327\225\327\250\327\231)\',\n    iconName: \'Boxe