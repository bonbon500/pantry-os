  planner_response {
    response: "\360\237\222\254 **\327\236\327\242\327\240\327\224 \327\231\327\251\327\231\327\250 / \327\241\327\231\327\233\327\225\327\235 \327\244\327\242\327\225\327\234\327\224:**\n\n\360\237\232\200 **\327\236\327\242\327\250\327\233\327\252 Pantry OS \327\227\327\225\327\221\327\250\327\224 \327\221\327\224\327\246\327\234\327\227\327\224 \327\234\327\236\327\241\327\223 \327\224\327\240\327\252\327\225\327\240\327\231\327\235 Supabase (`azcvaybfajjvelwrpagu.supabase.co`)** \327\225\327\233\327\234 4 \327\224\327\242\327\240\327\244\327\231\327\235 \327\244\327\225\327\242\327\234\327\231\327\235 \327\221\327\252\327\231\327\220\327\225\327\235 \327\236\327\234\327\220:\n\n1. \360\237\223\246 **\327\242\327\240\327\243 \327\224\327\236\327\234\327\220\327\231 (Inventory):** \327\240\327\231\327\224\327\225\327\234 \327\247\327\244\327\223\327\240\327\231 \327\234\327\244\327\231 \327\220\327\250\327\231\327\226\327\225\327\252/\327\231\327\227\327\231\327\223\327\225\327\252 \327\251\327\234\327\236\327\225\327\252 \327\221\327\234\327\221\327\223 (\327\246\327\240\327\246\327\240\327\225\327\252, \327\247\327\225\327\244\327\241\327\220\327\225\327\252, \327\251\327\247\327\231\327\225\327\252, \327\227\327\221\327\231\327\234\327\225\327\252, \327\242\327\246\327\231\327\246\327\231\327\235), \327\241\327\240\327\233\327\250\327\225\327\237 7 \327\224\327\241\327\234\327\225\327\230\327\231\327\235 \327\224\327\244\327\231\327\226\327\231\327\231\327\235, \327\233\327\250\327\230\327\231\327\241\327\231\327\231\327\252 \327\244\327\250\327\231\327\230 \327\236\327\224\327\231\327\250\327\224 (+ / -) \327\225\327\227\327\231\327\234\327\225\327\245 \327\236\327\247\"\327\230/\327\221\327\250\327\247\327\225\327\223 EAN-13 \327\236\327\247\327\221\327\234\327\225\327\252 \327\225\327\224\327\225\327\223\327\242\327\225\327\252 \327\247\327\225\327\234\327\231\327\225\327\252.\n2. \360\237\215\263 **\327\242\327\240\327\243 \327\224\327\221\327\231\327\251\327\225\327\234 (Cooking & Prep):** \327\247\327\234\327\231\327\230\327\252 \327\252\327\225\327\233\327\240\327\231\327\225\327\252 \327\221\327\231\327\251\327\225\327\234 \327\221\327\230\327\247\327\241\327\230/\327\247\327\225\327\234, \327\244\327\231\327\250\327\225\327\247 \327\234\327\222\327\225\327\250\327\236\327\231\327\235, \327\224\327\246\327\234\327\221\327\252 \327\226\327\236\327\231\327\240\327\225\327\252 \327\234\327\244\327\231 \327\241\327\234\327\225\327\230\327\231\327\235, \327\224\327\225\327\241\327\244\327\252 \327\227\327\225\327\241\327\250\327\231\327\235 \327\220\327\225\327\230\327\225\327\236\327\230\327\231\327\252 \327\234\327\241\327\234 \327\224\327\247\327\240\327\231\327\225\327\252 \327\225\327\222\327\250\327\231\327\242\327\252 \327\220\327\250\327\231\327\226\327\225\327\252 \327\236\327\231\327\231\327\223\327\231\327\252 \327\221\327\241\327\231\327\225\327\235 \327\224\327\221\327\231\327\251\327\225\327\234.\n3. \360\237\233\222 **\327\242\327\240\327\243 \327\224\327\247\327\240\327\231\327\225\327\252 (Procurement & Cart):** \327\252\327\246\327\225\327\222\327\224 \327\236\327\244\327\225\327\246\327\234\327\252 (Split View) \327\242\327\235 \327\246\'\327\247\327\234\327\231\327\241\327\230 \327\227\327\225\327\241\327\250\327\231\327\235 \327\223\327\231\327\240\327\236\327\231, \327\251\327\220\327\231\327\234\327\252\327\225\327\252 \327\227\327\231\327\244\327\225\327\251 \327\236\327\223\327\225\327\231\327\247\327\225\327\252 \327\234\327\241\327\225\327\244\327\250 \327\225\327\227\327\234\327\225\327\237 \327\236\327\246\327\221 \327\236\327\226\327\225\327\225\327\224 \327\251\327\247\327\230 (Pantry Glance) \327\234\327\252\327\225\327\241\327\244\327\252 \327\236\327\224\327\231\327\250\327\224.\n4. \360\237\223\212 **\327\242\327\240\327\243 \327\236\327\221\327\230-\327\242\327\234 \327\225\327\233\327\234\327\233\327\234\327\224 (BI & Analytics):** \327\244\327\231\327\234\327\225\327\227 \327\224\3