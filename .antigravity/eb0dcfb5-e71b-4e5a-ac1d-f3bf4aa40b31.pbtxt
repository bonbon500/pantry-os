        replacement_content: "import { StockMovementModal } from \'./components/StockMovementModal\';\nimport { EnginePayloadInspector } from \'./components/EnginePayloadInspector\';\nimport { AuthModal } from \'./components/AuthModal\';\n\nconst MainLayout: React.FC = () => {\n  const { activeTab, isAuthModalOpen, setIsAuthModalOpen } = usePantry();\n  const [isStockModalOpen, setIsStockModalOpen] = useState(false);\n\n  return (\n    <div className=\"min-h-screen bg-zinc-100 dark:bg-zinc-950 text-zinc-900 dark:text-zinc-100 flex flex-col transition-colors\">\n      <Navbar onOpenStockModal={() => setIsStockModalOpen(true)} />\n\n      <main className=\"flex-1 max-w-7xl w-full mx-auto px-4 sm:px-6 lg:px-8 py-6\">\n        {activeTab === \'pantry\' && (\n          <PhysicalRackView onOpenStockModal={() => setIsStockModalOpen(true)} />\n        )}\n        {activeTab === \'cooking\' && <CookingBranchView />}\n        {activeTab === \'shopping\' && <ShoppingBranchView />}\n        {activeTab === \'analytics\' && <AnalyticsBranchView />}\n        {activeTab === \'copilot\' && <CopilotView />}\n      </main>\n\n      {/* Modals and Drawers */}\n      <StockMovementModal\n        isOpen={isStockModalOpen}\n        onClose={() => setIsStockModalOpen(false)}\n      />\n      <AuthModal\n        isOpen={isAuthModalOpen}\n        onClose={() => setIsAuthModalOpen(false)}\n      />\n      <EnginePayloadInspector />\n    </div>\n  );\n};"
      }
      num_matches: 1
    }
  }
}
