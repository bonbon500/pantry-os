          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        } else if (itemName.includes(\'\327\242\327\222\327\221\327\240\327\231\327\225\327\252\') || itemName.includes(\'\327\221\327\246\327\234\') || itemName.includes(\'\327\236\327\234\327\244\327\244\327\225\327\237\') || itemName.includes(\'\327\244\327\234\327\244\327\234\') || itemName.includes(\'\327\230\327\225\327\244\327\225\') || itemName.includes(\'\327\221\327\231\327\246\327\231\327\235\') || itemName.includes(\'\327\222\327\221\327\231\327\240\')) {"
