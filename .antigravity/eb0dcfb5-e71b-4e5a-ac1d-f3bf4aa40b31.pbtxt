  file_change {
    absolute_path_uri: "file:///src/components/AuthScreen.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport {\n  signInWithEmailPassword,\n  signUpWithEmailPassword,\n  signInWithMagicLink,\n  signInAnonymously,\n} from \'../lib/supabase\';\nimport { usePantry } from \'../context/PantryContext\';\nimport {\n  Boxes,\n  LogIn,\n  UserPlus,\n  Mail,\n  Lock,\n  Sparkles,\n  CheckCircle2,\n  AlertCircle,\n  ShieldCheck,\n  Database,\n  ArrowLeft,\n  Layers,\n  ShoppingCart,\n  Zap,\n  Info,\n} from \'lucide-react\';\n\ninterface AuthScreenProps {\n  onSuccess?: () => void;\n}\n\nexport const AuthScreen: React.FC<AuthScreenProps> = ({ onSuccess }) => {\n  const { setCurrentUser } = usePantry();\n  const [mode, setMode] = useState<\'signin\' | \'signup\' | \'magic\'>(\'signin\');\n  const [email, setEmail] = useState(\'\');\n  const [password, setPassword] = useState(\'\');\n  const [isLoading, setIsLoading] = useState(false);\n  const [isQuickLoginLoading, setIsQuickLoginLoading] = useState(false);\n  const [errorMessage, setErrorMessage] = useState<string | null>(null);\n  const [successMessage, setSuccessMessage] = useState<string | null>(null);\n  const [needsEmailConfirmation, setNeedsEmailConfirmation] = useState(false);\n\n  const handleModeChange = (newMode: \'signin\' | \'signup\' | \'magic\') => {\n    setMode(newMode);\n    setErrorMessage(null);\n    setSuccessMessage(null);\n    setNeedsEmailConfirmation(false);\n  };\n\n  const handleQuickLogin = async () => {\n    setIsQuickLoginLoading(true);\n    setErrorMessage(null);\n    setSuccessMessage(null);\n\n    try {\n      // 1. Try Supabase Anonymous sign in\n      const { data, error } = await signInAnonymously();\n      if (!error && data?.user) {\n        setSuccessMessage(\'\327\224\327\252\327\227\327\221\327\250\327\252 \327\221\327\224\327\246\327\234\327\227\327\224 \327\221\327\233\327\240\327\231\327\241\327\224 \327\236\327\224\327\231\327\250\327\224! \327\230\327\225\327\242\327\237 \327\220\327\252 \327\224\327\236\327\226\327\225\327\225\327\224...\');\n        setTimeout(() => {\n          onSuccess?.();\n        }, 500);\n        return;\n      }\n\n      // 2. If anonymous is disabled in Supabase, create a local session so user is never blocked\n      const guestUser: any = {\n        id: \'guest_\' + Math.random().toString(36).substring(2, 9),\n        email: \'guest@pantry.os\',\n        user_metadata: { name: \'\327\236\327\251\327\252\327\236\327\251 \327\236\327\226\327\225\327\225\327\224\' },\n        app_metadata: { provider: \'demo\' },\n        aud: \'authenticated\',\n        created_at: new Date().toISOString(),\n      };\n      \n      setCurrentUser(guestUser);\n      setSuccessMessage(\'\327\221\327\250\327\225\327\232 \327\224\327\221\327\220! \327\240\327\233\327\240\327\241\327\252 \327\221\327\236\327\246\327\221 \327\236\327\226\327\225\327\225\327\224 \327\220\327\231\327\251\327\231.\');\n      setTimeout(() => {\n        onSuccess?.();\n      }, 500);\n    } catch (err: any) {\n      console.warn(\'Quick login fallback:\', err);\n      // Fallback guest user\n      const guestUser: any = {\n        id: \'guest_\' + Math.random().toString(36).substring(2, 9),\n        email: \'guest@pantry.os\',\n        user_metadata: { name: \'\327\236\327\251\327\252\327\236\327\251 \327\236\327\226\327\225\327\225\327\224\' },\n        app_metadata: { provider: \'demo\' },\n        aud: \'authenticated\',\n        created_at: new Date().toISOString(),\n      };\n      setCurrentUser(guestUser);\n      onSuccess?.();\n    } finally {\n      setIsQuickLoginLoading(false);\n    }\n  };\n\n  const handleSubmit = async (e: React.FormEvent) => {\n    e.preventDefault();\n    setErrorMessage(null);\n    setSuccessMessage(null);\n    setNeedsEmailConfirmation(false);\n\n    const cleanEmail = email.trim();\n    if (!cleanEmail) {\n      setErrorMessage(\'\327\240\327\220 \327\234\327\224\327\226\327\231\327\237 \327\233\327\252\327\225\327\221\327\252 \327\220\327\231\327\236\327\231\327\231\327\234 \327\252\327\247\327\231\327\240\327\224\');\n      return;\n    }\n\n    if (mode !== \'magic\' && password.length < 6) {\n      setErrorMessage(\'\327\224\327\241\327\231\327\241\327\236\327\224 \327\227\327\231\327\231\327\221\327\252 \327\234\327\224\327\233\327\231\327\234 \327\234\327\244\327\227\327\225\327\252 6 \327\252\327\225\327\225\327\231\327\235\');\n      return;\n    }\n\n    setIsLoading(true);\n\n    try {\n      if (mode === \'signin\') {\n        const { data, error } = await signInWithEmailPassword(cleanEmail, password);\n        if (error) {\n          if (error.message.includes(\'Invalid login credentials\')) {\n            setErrorMessage(\'\327\244\327\250\327\230\327\231 \327\224\327\252\327\227\327\221\327\250\327\225\327\252 \327\251\327\222\327\225\327\231\327\231\327\235. \327\221\327\223\327\225\327\247 \327\220\327\252 \327\224\327\241\327\231\327\241\327\236\327\224 \327\220\327\225 \327\224\327\250\327\251\327\235 \327\233\327\236\327\251\327\252\327\236\327\251 \327\227\327\223\327\251 \327\221\327\234\327\251\327\225\327\240\327\231\327\252 \"\327\224\327\250\327\251\327\236\327\224\".\');\n          } else if (error.message.includes(\'Email not confirmed\')) {\n            setNeedsEmailConfirmation(true);\n            setErrorMessage(\'\327\233\327\252\327\225\327\221\327\252 \327\224\327\236\327\231\327\231\327\234 \327\230\327\250\327\235 \327\220\327\225\327\236\327\252\327\224. \327\221\327\223\327\225\327\247 \327\220\327\252 \327\252\327\231\327\221\327\252 \327\224\327\223\327\225\327\220\327\250 \327\224\327\240\327\233\327\240\327\241 \327\220\327\225 \327\224\327\251\327\252\327\236\327\251 \327\221\327\233\327\240\327\231\327\241\327\224 \327\236\327\224\327\231\327\250\327\224.\');\n          } else {\n            setErrorMessage(`\327\251\327\222\327\231\327\220\327\252 \327\224\327\252\327\227\327\221\327\250\327\225\327\252: ${error.message}`);\n          }\n        } else if (data.user) {\n          setSuccessMessage(\'\327\224\327\252\327\227\327\221\327\250\327\252 \327\221\327\224\327\246\327\234\327\227\327\224! \327\230\327\225\327\242\327\237 \327\220\327\252 \327\240\327\252\327\225\327\240\327\231 \327\224\327\236\327\226\327\225\327\225\327\224 \327\251\327\234\327\232 \327\236-Supabase...\');\n          setTimeout(() => {\n            onSuccess?.();\n          }, 500);\n        }\n      } else if (mode === \'signup\') {\n        const { data, error } = await signUpWithEmailPassword(cleanEmail, password);\n        \n        if (error) {\n          if (error.message.includes(\'User already registered\') || error.message.includes(\'already exists\')) {\n            setErrorMessage(\'\327\233\327\252\327\225\327\221\327\252 \327\236\327\231\327\231\327\234 \327\226\327\225 \327\233\327\221\327\250 \327\250\327\251\327\225\327\236\327\224 \327\221\327\236\327\242\327\250\327\233\327\252! \327\234\327\227\327\245 \327\242\327\234 \327\233\327\244\327\252\327\225\327\250 \"\327\233\327\240\327\231\327\241\327\224\" \327\234\327\236\327\230\327\224 \327\233\327\223\327\231 \327\234\327\224\327\252\327\227\327\221\327\250.\');\n          } else if (error.message.includes(\'rate limit\')) {\n            setErrorMessage(\'\327\224\327\222\327\242\327\252 \327\234\327\236\327\222\327\221\327\234\327\252 \327\251\327\234\327\231\327\227\327\252 \327\236\327\231\327\231\327\234\327\231\327\235 \327\251\327\234 \327\251\327\250\327\252 \327\224\327\220\327\231\327\236\327\225\327\252. \327\221\327\220\327\244\327\251\327\250\327\225\327\252\327\232 \327\234\327\224\327\252\327\227\327\221\327\250 \327\231\327\251\327\231\327\250\327\225\327\252 \327\220\327\225 \327\234\327\224\327\251\327\252\327\236\327\251 \327\221\"\327\233\327\240\327\231\327\241\327\224 \327\236\327\224\327\231\327\250\327\224\".\');\n          } else if (error.message.includes(\'Signup is disabled\')) {\n            setErrorMessage(\'\327\224\327\250\327\251\327\236\327\252 \327\236\327\251\327\252\327\236\327\251\327\231\327\235 \327\227\327\223\327\251\327\231\327\235 \327\241\327\222\327\225\327\250\327\224 \327\226\327\236\327\240\327\231\327\252 \327\221\327\244\327\250\327\225\327\231\327\247\327\230 \327\226\327\224. \327\252\327\225\327\233\327\234 \327\234\327\224\327\231\327\233\327\240\327\241 \327\242\327\235 \327\236\327\251\327\252\327\236\327\251 \327\247\327\231\327\231\327\235 \327\220\327\225 \327\223\327\250\327\232 \"\327\233\327\240\327\231\327\241\327\224 \327\236\327\224\327\231\327\250\327\224\".\');\n          } else {\n            setErrorMessage(`\327\251\327\222\327\231\327\220\327\224 \327\221\327\250\327\231\327\251\327\225\327\235: ${error.message}`);\n          }\n        } else if (data.user) {\n          // If session was returned, user is already active\n          if (data.session) {\n            setSuccessMessage(\'\327\240\327\250\327\251\327\236\327\252 \327\221\327\224\327\246\327\234\327\227\327\224! \327\241\327\221\327\231\327\221\327\252 \327\224\327\236\327\226\327\225\327\225\327\224 \327\224\327\220\327\231\327\251\327\231\327\252 \327\251\327\234\327\232 \327\236\327\225\327\233\327\240\327\224.\');\n            setTimeout(() => {\n              onSuccess?.();\n            }, 600);\n          } else {\n            // Email confirmation is required by Supabase project settings\n            // Let\'s try immediate sign in just in case\n            const signInRes = await signInWithEmailPassword(cleanEmail, password);\n            if (signInRes.data?.session) {\n              setSuccessMessage(\'\327\224\327\224\327\250\327\251\327\236\327\224 \327\225\327\224\327\224\327\252\327\227\327\221\327\250\327\225\327\252 \327\224\327\225\327\251\327\234\327\236\327\225 \327\221\327\224\327\246\327\234\327\227\327\224!\');\n              setTimeout(() => {\n                onSuccess?.();\n              }, 600);\n            } else {\n              setNeedsEmailConfirmation(true);\n              setSuccessMessage(`\327\224\327\227\327\251\327\221\327\225\327\237 \327\240\327\225\327\246\327\250 \327\221\327\224\327\246\327\234\327\227\327\224! \327\251\327\231\327\235 \327\234\327\221: Supabase \327\251\327\234\327\227 \327\236\327\231\327\231\327\234 \327\220\327\231\327\236\327\225\327\252 \327\234-${cleanEmail}. \327\220\327\240\327\220 \327\220\327\251\327\250 \327\220\327\252 \327\224\327\247\327\231\327\251\327\225\327\250 \327\221\327\236\327\231\327\231\327\234.`);\n            }\n          }\n        }\n      } else if (mode === \'magic\') {\n        const { error } = await signInWithMagicLink(cleanEmail);\n        if (error) {\n          setErrorMessage(`\327\251\327\222\327\231\327\220\327\224 \327\221\327\251\327\234\327\231\327\227\327\252 \327\247\327\231\327\251\327\225\327\250 \327\247\327\241\327\235: ${error.message}`);\n        } else {\n          setSuccessMessage(`\327\247\327\231\327\251\327\225\327\250 \327\233\327\240\327\231\327\241\327\224 \327\236\327\220\327\225\327\221\327\230\327\227 \327\240\327\251\327\234\327\227 \327\234-${cleanEmail}. \327\221\327\223\327\225\327\247 \327\220\327\252 \327\252\327\231\327\221\327\252 \327\224\327\223\327\225\327\220\327\250 \327\251\327\234\327\232.`);\n        }\n      }\n    } catch (err: any) {\n      setErrorMessage(err.message || \'\327\220\327\231\327\250\327\242\327\224 \327\251\327\222\327\231\327\220\327\224 \327\221\327\234\327\252\327\231 \327\246\327\244\327\225\327\231\327\224 \327\221\327\252\327\224\327\234\327\231\327\232 \327\224\327\220\327\231\327\236\327\225\327\252\');\n    } finally {\n      setIsLoading(false);\n    }\n  };\n\n  return (\n    <div\n      className=\"min-h-screen bg-gradient-to-br from-zinc-50 via-zinc-100 to-emerald-50/40 dark:from-zinc-950 dark:via-zinc-900 dark:to-zinc-950 flex items-center justify-center p-4 sm:p-6 lg:p-8\"\n      dir=\"rtl\"\n      id=\"screen-auth-guard\"\n    >\n      <div className=\"w-full max-w-4xl grid grid-cols-1 lg:grid-cols-12 bg-white dark:bg-zinc-900 rounded-3xl border border-zinc-200/80 dark:border-zinc-800 shadow-2xl overflow-hidden\">\n        \n        {/* Left Side: Brand & Feature Highlights */}\n        <div className=\"lg:col-span-5 bg-gradient-to-br from-emerald-800 via-teal-900 to-zinc-900 text-white p-8 sm:p-10 flex flex-col justify-between relative overflow-hidden\">\n          {/* Subtle Ambient Glow */}\n          <div className=\"absolute -top-24 -right-24 w-60 h-60 bg-emerald-500/20 rounded-full blur-3xl pointer-events-none\" />\n          <div className=\"absolute -bottom-24 -left-24 w-60 h-60 bg-teal-400/20 rounded-full blur-3xl pointer-events-none\" />\n\n          <div className=\"relative z-10\">\n            <div className=\"flex items-center gap-3 mb-8\">\n              <div className=\"w-12 h-12 rounded-2xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center text-emerald-300 shadow-inner\">\n                <Boxes className=\"w-6 h-6\" />\n              </div>\n              <div>\n                <h1 className=\"text-2xl font-black tracking-tight text-white\">\n                  Pantry OS\n                </h1>\n                <p className=\"text-xs text-emerald-200/80 font-medium\">\n                  \327\236\327\242\327\250\327\233\327\252 \327\224\327\244\327\242\327\234\327\224 \327\227\327\233\327\236\327\224 \327\234\327\236\327\226\327\225\327\225\327\224 \327\224\327\244\327\231\327\226\327\231\n                </p>\n              </div>\n            </div>\n\n            <h2 className=\"text-lg sm:text-xl font-bold leading-snug mb-3 text-emerald-50\">\n              \327\240\327\231\327\224\327\225\327\234 \327\236\327\234\327\220\327\231 \327\236\327\223\327\225\327\231\327\247, \327\221\327\231\327\251\327\225\327\234 \327\227\327\233\327\235 \327\225\327\241\327\240\327\233\327\250\327\225\327\237 \327\242\327\240\327\237 \327\220\327\231\327\251\327\231\n            </h2>\n            <p className=\"text-xs sm:text-sm text-emerald-100/70 leading-relaxed mb-8\">\n              \327\233\327\234 \327\224\327\236\327\226\327\225\327\225\327\224 \327\251\327\234\327\232 \327\236\327\236\327\225\327\244\327\224 \327\225\327\236\327\241\327\225\327\240\327\233\327\250\327\237 \327\221\327\226\327\236\327\237 \327\220\327\236\327\252 \327\234\327\236\327\241\327\223 \327\224\327\240\327\252\327\225\327\240\327\231\327\235 Supabase, \327\236\327\221\327\225\327\223\327\223 \327\234\327\227\327\234\327\225\327\230\327\231\327\237 \327\234\327\244\327\231 \327\224\327\236\327\251\327\252\327\236\327\251 \327\251\327\234\327\232.\n            </p>\n\n            <div className=\"space-y-4\">\n              <div className=\"flex items-start gap-3 bg-white/5 border border-white/10 rounded-2xl p-3.5 backdrop-blur-sm\">\n                <div className=\"p-2 rounded-xl bg-emerald-500/20 text-emerald-300 mt-0.5\">\n                  <Layers className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <h4 className=\"text-xs font-bold text-white\">\327\236\327\221\327\240\327\224 7 \327\241\327\234\327\225\327\230\327\231\327\235 \327\244\327\231\327\226\327\231\327\231\327\235</h4>\n                  <p className=\"text-[11px] text-emerald-100/70 mt-0.5\">\n                    \327\246\327\240\327\246\327\240\327\225\327\252, \327\251\327\231\327\236\327\225\327\250\327\231\327\235, \327\250\327\230\327\221\327\231\327\235 \327\225\327\236\327\222\327\231\327\250\327\225\327\252 \327\236\327\251\327\247 \327\221\327\231\327\252 \327\221\327\236\327\221\327\240\327\224 \327\247\327\221\327\225\327\242 \327\225\327\220\327\227\327\231\327\223\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-3 bg-white/5 border border-white/10 rounded-2xl p-3.5 backdrop-blur-sm\">\n                <div className=\"p-2 rounded-xl bg-emerald-500/20 text-emerald-300 mt-0.5\">\n                  <ShoppingCart className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <h4 className=\"text-xs font-bold text-white\">\327\241\327\240\327\233\327\250\327\225\327\237 \327\241\327\234 \327\247\327\240\327\231\327\225\327\252 \327\220\327\225\327\230\327\225\327\236\327\230\327\231</h4>\n                  <p className=\"text-[11px] text-emerald-100/70 mt-0.5\">\n                    \327\227\327\225\327\241\327\250\327\231\327\235 \327\236\327\225\327\242\327\221\327\250\327\231\327\235 \327\220\327\225\327\230\327\225\327\236\327\230\327\231\327\252 \327\234\327\250\327\251\327\231\327\236\327\252 \327\224\327\247\327\240\327\231\327\225\327\252 \327\225\327\236\327\241\327\225\327\240\327\233\327\250\327\240\327\231\327\235 \327\234\327\242\327\240\327\237\n                  </p>\n                </div>\n              </div>\n\n              <div className=\"flex items-start gap-3 bg-white/5 border border-white/10 rounded-2xl p-3.5 backdrop-blur-sm\">\n                <div className=\"p-2 rounded-xl bg-emerald-500/20 text-emerald-300 mt-0.5\">\n                  <Database className=\"w-4 h-4\" />\n                </div>\n                <div>\n                  <h4 className=\"text-xs font-bold text-white\">\327\220\327\221\327\230\327\227\327\252 Supabase \327\236\327\234\327\220\327\224</h4>\n                  <p className=\"text-[11px] text-emerald-100/70 mt-0.5\">\n                    \327\221\327\231\327\223\327\225\327\223 \327\236\327\225\327\227\327\234\327\230 \327\234\327\244\327\231 <code className=\"text-[10px] bg-black/30 px-1 py-0.5 rounded\">user_id</code>\n                  </p>\n                </div>\n              </div>\n            </div>\n          </div>\n\n          {/* Footer Badge */}\n          <div className=\"relative z-10 mt-8 pt-6 border-t border-white/10 flex items-center justify-between text-xs text-emerald-200/80\">\n            <span className=\"flex items-center gap-1.5 font-mono text-[11px]\">\n              <span className=\"w-2 h-2 rounded-full bg-emerald-400 animate-pulse\" />\n              <span>azcvaybfajjvelwrpagu.supabase.co</span>\n            </span>\n            <span className=\"text-[11px]\">\327\222\327\250\327\241\327\224 2.4 Cloud</span>\n          </div>\n        </div>\n\n        {/* Right Side: Auth Form */}\n        <div className=\"lg:col-span-7 p-8 sm:p-10 flex flex-col justify-center\">\n          <div className=\"max-w-md w-full mx-auto\">\n            {/* Header */}\n            <div className=\"mb-6\">\n              <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-emerald-50 dark:bg-emerald-950/60 text-emerald-700 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800 text-xs font-medium mb-3\">\n                <ShieldCheck className=\"w-3.5 h-3.5\" />\n                <span>\327\233\327\240\327\231\327\241\327\224 \327\236\327\220\327\225\327\221\327\230\327\227\327\252</span>\n              </div>\n              <h3 className=\"text-2xl font-black text-zinc-900 dark:text-white tracking-tight\">\n                {mode === \'signin\' && \'\327\233\327\240\327\231\327\241\327\224 \327\234\327\236\327\242\327\250\327\233\327\252 \327\224\327\236\327\226\327\225\327\225\327\224\'}\n                {mode === \'signup\' && \'\327\224\327\250\327\251\327\236\327\224 \327\234\327\227\327\251\327\221\327\225\327\237 \327\236\327\226\327\225\327\225\327\224 \327\227\327\223\327\251\'}\n                {mode === \'magic\' && \'\327\233\327\240\327\231\327\241\327\224 \327\242\327\235 \327\247\327\231\327\251\327\225\327\250 \327\247\327\241\327\235 (Magic Link)\'}\n              </h3>\n              <p className=\"text-xs sm:text-sm text-zinc-500 dark:text-zinc-400 mt-1\">\n                {mode === \'signin\' && \'\327\224\327\226\327\237 \327\220\327\252 \327\224\327\223\327\225\327\220\"\327\234 \327\225\327\224\327\241\327\231\327\241\327\236\327\224 \327\233\327\223\327\231 \327\234\327\222\327\251\327\252 \327\234\327\236\327\234\327\220\327\231 \327\225\327\234\327\241\327\234 \327\224\327\247\327\240\327\231\327\225\327\252 \327\251\327\234\327\232.\'}\n                {mode === \'signup\' && \'\327\224\327\226\327\237 \327\223\327\225\327\220\"\327\234 \327\225\327\241\327\231\327\241\327\236\327\224 \327\234\327\224\327\247\327\236\327\252 \327\236\327\250\327\227\327\221 \327\236\327\226\327\225\327\225\327\224 \327\220\327\231\327\251\327\231 \327\227\327\223\327\251 \327\221\327\236\327\241\327\223 \327\224\327\240\327\252\327\225\327\240\327\231\327\235.\'}\n                {mode === \'magic\' && \'\327\247\327\221\327\234 \327\247\327\231\327\251\327\225\327\250 \327\233\327\240\327\231\327\241\327\224 \327\236\327\220\327\225\327\221\327\230\327\227 \327\231\327\251\327\231\327\250\327\225\327\252 \327\234\327\252\327\231\327\221\327\252 \327\224\327\223\327\225\327\220\327\250 \327\234\327\234\327\220 \327\246\327\225\327\250\327\232 \327\221\327\241\327\231\327\241\327\236\327\224.\'}\n              </p>\n            </div>\n\n            {/* Mode Switcher Tabs */}\n            <div className=\"flex p-1 bg-zinc-100 dark:bg-zinc-800/80 rounded-2xl mb-6 text-xs font-semibold\">\n              <button\n                type=\"button\"\n                onClick={() => handleModeChange(\'signin\')}\n                id=\"btn-tab-auth-signin\"\n                className={`flex-1 py-2.5 rounded-xl transition-all flex items-center justify-center gap-2 ${\n                  mode === \'signin\'\n                    ? \'bg-white dark:bg-zinc-700 text-zinc-900 dark:text-white shadow-sm font-bold\'\n                    : \'text-zinc-500 dark:text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-200\'\n                }`}\n              >\n                <LogIn className=\"w-4 h-4\" />\n                <span>\327\233\327\240\327\231\327\241\327\224</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleModeChange(\'signup\')}\n                id=\"btn-tab-auth-signup\"\n                className={`flex-1 py-2.5 rounded-xl transition-all flex items-center justify-center gap-2 ${\n                  mode === \'signup\'\n                    ? \'bg-white dark:bg-zinc-700 text-zinc-900 dark:text-white shadow-sm font-bold\'\n                    : \'text-zinc-500 dark:text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-200\'\n                }`}\n              >\n                <UserPlus className=\"w-4 h-4\" />\n                <span>\327\224\327\250\327\251\327\236\327\224</span>\n              </button>\n              <button\n                type=\"button\"\n                onClick={() => handleModeChange(\'magic\')}\n                id=\"btn-tab-auth-magic\"\n                className={`flex-1 py-2.5 rounded-xl transition-all flex items-center justify-center gap-2 ${\n                  mode === \'magic\'\n                    ? \'bg-white dark:bg-zinc-700 text-zinc-900 dark:text-white shadow-sm font-bold\'\n                    : \'text-zinc-500 dark:text-zinc-400 hover:text-zinc-800 dark:hover:text-zinc-200\'\n                }`}\n              >\n                <Sparkles className=\"w-4 h-4 text-amber-500\" />\n                <span>Magic Link</span>\n              </button>\n            </div>\n\n            {/* Error Notification with Action Buttons */}\n            {errorMessage && (\n              <div\n                id=\"auth-error-banner\"\n                className=\"mb-5 p-4 bg-rose-50 dark:bg-rose-950/50 border border-rose-200 dark:border-rose-800/80 rounded-2xl text-xs text-rose-700 dark:text-rose-300 flex flex-col gap-2.5 animate-fadeIn\"\n              >\n                <div className=\"flex items-start gap-2.5\">\n                  <AlertCircle className=\"w-4 h-4 flex-shrink-0 mt-0.5 text-rose-600 dark:text-rose-400\" />\n                  <span className=\"leading-relaxed font-medium\">{errorMessage}</span>\n                </div>\n\n                {errorMessage.includes(\'\327\233\327\221\327\250 \327\250\327\251\327\225\327\236\327\224\') && (\n                  <button\n                    type=\"button\"\n                    onClick={() => handleModeChange(\'signin\')}\n                    className=\"self-start mt-1 px-3 py-1.5 bg-rose-600 hover:bg-rose-700 text-white rounded-xl font-bold text-xs flex items-center gap-1.5 transition-all shadow-sm\"\n                  >\n                    <LogIn className=\"w-3.5 h-3.5\" />\n                    <span>\327\242\327\221\327\225\327\250 \327\242\327\233\327\251\327\231\327\225 \327\234\327\236\327\241\327\232 \327\233\327\240\327\231\327\241\327\224</span>\n                  </button>\n                )}\n              </div>\n            )}\n\n            {/* Success Notification */}\n            {successMessage && (\n              <div\n                id=\"auth-success-banner\"\n                className=\"mb-5 p-4 bg-emerald-50 dark:bg-emerald-950/50 border border-emerald-200 dark:border-emerald-800/80 rounded-2xl text-xs text-emerald-800 dark:text-emerald-300 flex flex-col gap-2 animate-fadeIn\"\n              >\n                <div className=\"flex items-start gap-2.5\">\n                  <CheckCircle2 className=\"w-4 h-4 flex-shrink-0 mt-0.5 text-emerald-600 dark:text-emerald-400\" />\n                  <span className=\"leading-relaxed font-medium\">{successMessage}</span>\n                </div>\n                {needsEmailConfirmation && (\n                  <div className=\"mt-1 p-2.5 bg-emerald-100/60 dark:bg-emerald-900/40 rounded-xl text-[11px] flex items-center justify-between gap-2\">\n                    <span className=\"text-emerald-900 dark:text-emerald-200\">\327\250\327\225\327\246\327\224 \327\234\327\224\327\252\327\227\327\231\327\234 \327\234\327\242\327\221\327\225\327\223 \327\236\327\231\327\223 \327\234\327\234\327\220 \327\220\327\231\327\251\327\225\327\250 \327\236\327\231\327\231\327\234?</span>\n                    <button\n                      type=\"button\"\n                      onClick={handleQuickLogin}\n                      className=\"px-2.5 py-1 bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg font-bold text-[11px] whitespace-nowrap transition-all shadow-xs\"\n                    >\n                      \327\233\327\240\327\231\327\241\327\224 \327\236\327\224\327\231\327\250\327\224 &larr;\n                    </button>\n                  </div>\n                )}\n              </div>\n            )}\n\n            {/* Form */}\n            <form onSubmit={handleSubmit} className=\"space-y-4\">\n              <div>\n                <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300 mb-1.5\">\n                  \327\233\327\252\327\225\327\221\327\252 \327\220\327\231\327\236\327\231\327\231\327\234\n                </label>\n                <div className=\"relative\">\n                  <input\n                    type=\"email\"\n                    value={email}\n                    onChange={(e) => setEmail(e.target.value)}\n                    placeholder=\"name@example.com\"\n                    required\n                    id=\"input-auth-email-field\"\n                    className=\"w-full pl-3 pr-10 py-3 bg-zinc-50 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 rounded-2xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-zinc-900 dark:text-white transition-all\"\n                  />\n                  <Mail className=\"w-4 h-4 text-zinc-400 absolute right-3.5 top-3.5 pointer-events-none\" />\n                </div>\n              </div>\n\n              {mode !== \'magic\' && (\n                <div>\n                  <div className=\"flex items-center justify-between mb-1.5\">\n                    <label className=\"block text-xs font-semibold text-zinc-700 dark:text-zinc-300\">\n                      \327\241\327\231\327\241\327\236\327\224\n                    </label>\n                    <span className=\"text-[11px] text-zinc-400\">\327\234\327\244\327\227\327\225\327\252 6 \327\252\327\225\327\225\327\231\327\235</span>\n                  </div>\n                  <div className=\"relative\">\n                    <input\n                      type=\"password\"\n                      value={password}\n                      onChange={(e) => setPassword(e.target.value)}\n                      placeholder=\"\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\342\200\242\"\n                      required\n                      id=\"input-auth-password-field\"\n                      className=\"w-full pl-3 pr-10 py-3 bg-zinc-50 dark:bg-zinc-800/80 border border-zinc-200 dark:border-zinc-700 rounded-2xl text-sm focus:outline-none focus:ring-2 focus:ring-emerald-500 text-zinc-900 dark:text-white transition-all\"\n                    />\n                    <Lock className=\"w-4 h-4 text-zinc-400 absolute right-3.5 top-3.5 pointer-events-none\" />\n                  </div>\n                </div>\n              )}\n\n              <button\n                type=\"submit\"\n                disabled={isLoading || isQuickLoginLoading}\n                id=\"btn-auth-submit-action\"\n                className=\"w-full py-3.5 px-5 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-bold text-sm rounded-2xl transition-all shadow-lg shadow-emerald-600/20 disabled:opacity-50 flex items-center justify-center gap-2 mt-4\"\n              >\n                {isLoading ? (\n                  <>\n                    <span className=\"w-4 h-4 border-2 border-white/30 border-t-white rounded-full animate-spin\" />\n                    <span>\327\236\327\220\327\236\327\252 \327\236\327\225\327\234 \327\251\327\250\327\252 \327\224\327\240\327\252\327\225\327\240\327\231\327\235...</span>\n                  </>\n                ) : mode === \'signin\' ? (\n                  <>\n                    <LogIn className=\"w-4 h-4\" />\n                    <span>\327\224\327\252\327\227\327\221\327\250 \327\234\327\236\327\242\327\250\327\233\327\252</span>\n                    <ArrowLeft className=\"w-4 h-4 mr-1\" />\n                  </>\n                ) : mode === \'signup\' ? (\n                  <>\n                    <UserPlus className=\"w-4 h-4\" />\n                    <span>\327\246\327\225\327\250 \327\227\327\251\327\221\327\225\327\237 \327\236\327\226\327\225\327\225\327\224 \327\220\327\231\327\251\327\231</span>\n                    <ArrowLeft className=\"w-4 h-4 mr-1\" />\n                  </>\n                ) : (\n                  <>\n                    <Sparkles className=\"w-4 h-4\" />\n                    <span>\327\251\327\234\327\227 \327\234\327\231 \327\247\327\231\327\251\327\225\327\250 \327\233\327\240\327\231\327\241\327\224 \327\221\327\223\327\225\327\220\"\327\234</span>\n                  </>\n                )}\n              </button>\n            </form>\n\n            {/* Quick Instant Entry Option (Prevents ever getting blocked) */}\n            <div className=\"mt-6 pt-5 border-t border-zinc-100 dark:border-zinc-800 flex flex-col gap-2.5\">\n              <div className=\"flex items-center justify-between text-xs text-zinc-500 dark:text-zinc-400\">\n                <span>\327\250\327\225\327\246\327\224 \327\234\327\224\327\252\327\240\327\241\327\225\327\252 \327\221\327\236\327\242\327\250\327\233\327\252 \327\236\327\231\327\223?</span>\n                <span className=\"text-[11px] text-emerald-600 dark:text-emerald-400 font-medium\">\327\234\327\234\327\220 \327\246\327\225\327\250\327\232 \327\221\327\224\327\236\327\252\327\240\327\224 \327\234\327\236\327\231\327\231\327\234</span>\n              </div>\n              <button\n                type=\"button\"\n                onClick={handleQuickLogin}\n                disabled={isQuickLoginLoading || isLoading}\n                id=\"btn-auth-quick-guest-entry\"\n             