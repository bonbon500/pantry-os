  file_change {
    absolute_path_uri: "file:///src/components/CookingBranchView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { usePantry } from \'../context/PantryContext\';\nimport { CookingDish, RecipeSuggestion } from \'../types\';\nimport {\n  CookingPot,\n  Sparkles,\n  Flame,\n  Clock,\n  CheckCircle2,\n  AlertCircle,\n  Plus,\n  ChefHat,\n  Loader2,\n  Check,\n  ListOrdered,\n  Layers,\n} from \'lucide-react\';\n\nexport const CookingBranchView: React.FC = () => {\n  const { dishes, inventory, cookDish, isProcessing } = usePantry();\n  const [activeDishId, setActiveDishId] = useState<string | null>(dishes[0]?.id || null);\n  const [customServings, setCustomServings] = useState<number>(4);\n  const [cookingSuccess, setCookingSuccess] = useState<{ id: string; message: string } | null>(null);\n  const [zeroWasteSuggestions, setZeroWasteSuggestions] = useState<RecipeSuggestion[]>([]);\n  const [isGeneratingRecipes, setIsGeneratingRecipes] = useState(false);\n\n  // Generate zero-waste recipes using Gemini endpoint\n  const handleGenerateZeroWaste = async () => {\n    setIsGeneratingRecipes(true);\n    try {\n      const res = await fetch(\'/api/engine/zero-waste-recipes\', {\n        method: \'POST\',\n        headers: { \'Content-Type\': \'application/json\' },\n        body: JSON.stringify({\n          inventoryItems: inventory,\n          servings: customServings,\n        }),\n      });\n      if (res.ok) {\n        const data = await res.json();\n        if (Array.isArray(data)) {\n          setZeroWasteSuggestions(data);\n        }\n      }\n    } catch (err) {\n      console.error(\'Failed to generate zero waste recipes:\', err);\n    } finally {\n      setIsGeneratingRecipes(false);\n    }\n  };\n\n  const handleCook = (dish: CookingDish) => {\n    const res = cookDish(dish);\n    if (res.success) {\n      setCookingSuccess({\n        id: dish.id,\n        message: `\342\234\250 \327\221\327\225\327\251\327\234 \327\221\327\224\327\246\327\234\327\227\327\224! \327\233\327\234 \327\224\327\236\327\246\327\250\327\233\327\231\327\235 \327\240\327\222\327\250\327\242\327\225 \327\236\327\224\327\241\327\234\327\225\327\230\327\231\327\235 \327\224\327\244\327\231\327\226\327\231\327\231\327\235 \327\225\327\224\327\236\327\234\327\220\327\231 \327\242\327\225\327\223\327\233\327\237.`,\n      });\n    } else {\n      setCookingSuccess({\n        id: dish.id,\n        message: `\342\232\240\357\270\217 \327\224\327\236\327\240\327\224 \327\221\327\225\327\251\327\234\327\224, \327\225\327\227\327\225\327\241\327\250\327\231\327\235 \327\240\327\250\327\251\327\236\327\225 \327\221\327\250\327\251\327\231\327\236\327\252 \327\224\327\247\327\240\327\231\327\225\327\252: ${res.missingItems.join(\', \')}`,\n      });\n    }\n\n    setTimeout(() => {\n      setCookingSuccess(null);\n    }, 6000);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Zero Waste Banner */}\n      <div className=\"bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 rounded-2xl p-6 text-white shadow-md flex flex-col md:flex-row items-start md:items-center justify-between gap-4\">\n        <div className=\"space-y-1 max-w-xl\">\n          <div className=\"flex items-center gap-2\">\n            <span className=\"bg-white/20 text-white text-xs font-bold px-2.5 py-0.5 rounded-full uppercase tracking-wide\">\n              Zero-Waste Cooking Engine\n            </span>\n            <ChefHat className=\"w-4 h-4 text-emerald-200\" />\n          </div>\n          <h2 className=\"text-xl font-bold\">\327\236\327\240\327\225\327\242 \327\221\327\231\327\251\327\225\327\234 \327\220\327\244\327\241 \327\221\327\226\327\221\327\225\327\226 \327\236\327\221\327\225\327\241\327\241 \327\236\327\246\327\220\327\231 \327\247\327\231\327\231\327\235</h2>\n          <p className=\"text-xs text-emerald-100 leading-relaxed\">\n            \327\224\327\236\327\242\327\250\327\233\327\252 \327\241\327\225\327\250\327\247\327\252 \327\220\327\252 \327\233\327\234 7 \327\224\327\241\327\234\327\225\327\230\327\231\327\235 \327\224\327\244\327\231\327\226\327\231\327\231\327\235 \327\221\327\236\327\226\327\225\327\225\327\224, \327\221\327\236\327\247\327\250\327\250 \327\225\327\221\327\242\327\246\327\231\327\246\327\231 \327\224\327\222\327\231\327\240\327\224, \327\225\327\236\327\250\327\233\327\231\327\221\327\224 \327\236\327\252\327\233\327\225\327\240\327\231\327\235 \327\236\327\225\327\251\327\234\327\236\327\231\327\235 \327\234\327\234\327\220 \327\246\327\225\327\250\327\232 \327\221\327\247\327\240\327\231\327\225\327\252 \327\240\327\225\327\241\327\244\327\225\327\252!\n          </p>\n        </div>\n\n        <button\n          onClick={handleGenerateZeroWaste}\n          disabled={isGeneratingRecipes}\n          id=\"btn-generate-zero-waste\"\n          className=\"px-5 py-3 bg-white text-emerald-800 hover:bg-emerald-50 active:bg-emerald-100 text-xs font-bold rounded-xl shadow-md flex items-center gap-2 transition-all whitespace-nowrap self-stretch md:self-auto justify-center\"\n        >\n          {isGeneratingRecipes ? (\n            <>\n              <Loader2 className=\"w-4 h-4 animate-spin text-emerald-700\" />\n              <span>\327\241\327\225\327\250\327\247 \327\241\327\234\327\225\327\230\327\231\327\235 \327\225\327\231\327\225\327\246\327\250 \327\236\327\252\327\233\327\225\327\240\327\231\327\235...</span>\n            </>\n          ) : (\n            <>\n              <Sparkles className=\"w-4 h-4 text-amber-500\" />\n              <span>\327\224\327\246\327\242 \327\236\327\252\327\233\327\225\327\240\327\231\327\235 \327\227\327\233\327\236\327\231\327\235 \327\236\327\224\327\236\327\234\327\220\327\231 \327\224\327\247\327\231\327\231\327\235</span>\n            </>\n          )}\n        </button>\n      </div>\n\n      {/* Zero Waste Suggestions Result */}\n      {zeroWasteSuggestions.length > 0 && (\n        <div className=\"space-y-3 bg-amber-500/10 border border-amber-500/30 p-4 rounded-2xl\">\n          <div className=\"flex items-center gap-2 text-amber-800 dark:text-amber-300 font-bold text-sm\">\n            <Sparkles className=\"w-4 h-4\" />\n            <span>\327\224\327\246\327\242\327\225\327\252 \327\251\327\243 \327\236\327\225\327\252\327\220\327\236\327\225\327\252 \327\234\327\236\327\234\327\220\327\231 \327\251\327\234\327\232 \327\233\327\250\327\222\327\242:</span>\n          </div>\n          <div className=\"grid grid-cols-1 md:grid-cols-3 gap-3\">\n            {zeroWasteSuggestions.map((sugg, idx) => (\n              <div\n                key={idx}\n                className=\"bg-white dark:bg-zinc-800 p-4 rounded-xl border border-amber-200 dark:border-zinc-700 shadow-xs flex flex-col justify-between\"\n              >\n                <div>\n                  <div className=\"flex items-start justify-between gap-1\">\n                    <h4 className=\"font-bold text-sm text-zinc-900 dark:text-white\">{sugg.title}</h4>\n                    <span className=\"text-[10px] font-bold px-2 py-0.5 rounded bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300\">\n                      {sugg.matchPercentage}% \327\224\327\252\327\220\327\236\327\224\n                    </span>\n                  </div>\n                  <div className=\"text-xs text-zinc-500 mt-1 flex items-center gap-2\">\n                    <span className=\"flex items-center gap-1\">\n                      <Clock className=\"w-3 h-3\" />\n                      {sugg.prepTimeMinutes} \327\223\327\247\327\263\n                    </span>\n                    <span>\342\200\242</span>\n                    <span>\327\247\327\225\327\251\327\231: {sugg.difficulty}</span>\n                  </div>\n\n                  <div className=\"mt-3 space-y-1\">\n                    <div className=\"text-[11px] font-semibold text-zinc-600 dark:text-zinc-300\">\n                      \327\227\327\225\327\236\327\250\327\231 \327\222\327\234\327\235 \327\236\327\224\327\236\327\234\327\220\327\231:\n                    </div>\n                    <ul className=\"text-xs text-zinc-600 dark:text-zinc-400 space-y-0.5\">\n                      {sugg.usedInventoryItems?.map((ui, uIdx) => (\n                        <li key={uIdx} className=\"flex items-center gap-1\">\n                          <CheckCircle2 className=\"w-3 h-3 text-emerald-500 shrink-0\" />\n                          <span>\n                            {ui.name} ({ui.quantity})\n                          </span>\n                        </li>\n                      ))}\n                    </ul>\n                  </div>\n                </div>\n\n                <button\n                  onClick={() => {\n                    // Convert suggestion to cooking dish and run\n                    const newDish: CookingDish = {\n                      id: \'sugg-\' + Date.now(),\n                      name: sugg.title,\n                      category: \'Zero-Waste Chef\',\n                      servings: 4,\n                      ingredients: sugg.usedInventoryItems.map((ui) => ({\n                        itemName: ui.name,\n                        quantity: 0.2,\n                        unit: \'UNITS\',\n                      })),\n                      instructions: sugg.instructions || [],\n                    };\n                    handleCook(newDish);\n                  }}\n                  className=\"mt-4 w-full py-2 bg-emerald-600 hover:bg-emerald-700 text-white font-bold text-xs rounded-lg flex items-center justify-center gap-1.5 transition-colors\"\n                >\n                  <Flame className=\"w-3.5 h-3.5\" />\n                  <span>\327\221\327\251\327\234 \327\236\327\240\327\224 \327\226\327\225 \327\225\327\222\327\250\327\242 \327\236\327\224\327\236\327\234\327\220\327\231</span>\n                </button>\n              </div>\n            ))}\n          </div>\n        </div>\n      )}\n\n      {/* Main Dishes Catalogue & Decomposition */}\n      <div className=\"grid grid-cols-1 lg:grid-cols-3 gap-6\">\n        {/* Dish List Sidebar */}\n        <div className=\"space-y-3\">\n          <div className=\"text-sm font-bold text-zinc-800 dark:text-zinc-200 flex items-center gap-2\">\n            <CookingPot className=\"w-4 h-4 text-emerald-600\" />\n            <span>\327\252\327\244\327\250\327\231\327\230 \327\236\327\220\327\233\327\234\327\231\327\235 \327\225\327\236\327\252\327\233\327\225\327\240\327\231\327\235 \327\251\327\225\327\230\327\244\327\231\327\235</span>\n          </div>\n\n          <div className=\"space-y-2\">\n            {dishes.map((dish) => {\n              const isSelected = activeDishId === dish.id;\n              // Check availability\n              let fullyAvailable = true;\n              dish.ingredients.forEach((ing) => {\n                const item = inventory.find(\n                  (inv) => inv.name.toLowerCase().includes(ing.itemName.toLowerCase()) ||\n                           ing.itemName.toLowerCase().includes(inv.name.toLowerCase())\n                );\n                if (!item || item.quantity < ing.quantity) {\n                  fullyAvailable = false;\n                }\n              });\n\n              return (\n                <div\n                  key={dish.id}\n                  onClick={() => setActiveDishId(dish.id)}\n                  className={`p-4 rounded-xl border cursor-pointer transition-all ${\n                    isSelected\n                      ? \'bg-emerald-50 dark:bg-zinc-800 border-emerald-500 dark:border-emerald-500 shadow-xs\'\n                      : \'bg-white dark:bg-zinc-800/80 border-zinc-200 dark:border-zinc-700/80 hover:bg-zinc-50\'\n                  }`}\n                >\n                  <div className=\"flex items-start justify-between gap-2\">\n                    <h4 className=\"font-bold text-sm text-zinc-900 dark:text-white\">{dish.name}</h4>\n                    <span\n                      className={`text-[10px] font-bold px-2 py-0.5 rounded ${\n                        fullyAvailable\n                          ? \'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300\'\n                          : \'bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300\'\n                      }`}\n                    >\n                      {fullyAvailable ? \'\327\233\327\234 \327\224\327\250\327\233\327\231\327\221\327\231\327\235 \327\221\327\236\327\234\327\220\327\231\' : \'\327\227\327\241\327\250\327\231\327\235 \327\250\327\233\327\231\327\221\327\231\327\235\'}\n                    </span>\n                  </div>\n\n                  <div className=\"flex items-center gap-3 text-xs text-zinc-500 mt-2\">\n                    <span className=\"flex items-center gap-1\">\n                      <Layers className=\"w-3 h-3 text-zinc-400\" />\n                      {dish.ingredients.length} \327\227\327\225\327\236\327\250\327\231 \327\222\327\234\327\235\n                    </span>\n                    <span>\342\200\242</span>\n                    <span>{dish.category}</span>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n\n        {/* Active Dish Detail & Breakdown */}\n        {activeDishId && (\n          <div className=\"lg:col-span-2\">\n            {(() => {\n              const dish = dishes.find((d) => d.id === activeDishId);\n              if (!dish) return null;\n\n              return (\n                <div className=\"bg-white dark:bg-zinc-800 rounded-2xl border border-zinc-200 dark:border-zinc-700 p-6 shadow-xs space-y-6\">\n                  {/* Dish Header */}\n                  <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 border-b border-zinc-200 dark:border-zinc-700 pb-4\">\n                    <div>\n                      <div className=\"flex items-center gap-2\">\n                        <h3 className=\"text-lg font-bold text-zinc-900 dark:text-white\">{dish.name}</h3>\n                        <span className=\"text-xs px-2 py-0.5 rounded-full bg-zinc-100 dark:bg-zinc-700 text-zinc-600 dark:text-zinc-300 font-medium\">\n                          {dish.category}\n                        </span>\n                      </div>\n                      <p className=\"text-xs text-zinc-500 mt-1\">\n                        \327\244\327\231\327\250\327\225\327\247 \327\234\327\227\327\225\327\236\327\250\327\231 \327\222\327\234\327\235 \327\221\327\241\327\231\327\241\327\231\327\231\327\235, \327\251\327\231\327\225\327\232 \327\234\327\241\327\234\327\225\327\230\327\231\327\235 \327\224\327\244\327\231\327\226\327\231\327\231\327\235 \327\225\327\221\327\223\327\231\327\247\327\252 \327\226\327\236\327\231\327\240\327\225\327\252\n                      </p>\n                    </div>\n\n                    <div className=\"flex items-center gap-2\">\n                      <button\n                        onClick={() => handleCook(dish)}\n                        id={`btn-cook-dish-${dish.id}`}\n                        className=\"px-4 py-2 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-bold text-xs rounded-xl shadow-xs flex items-center gap-2 transition-all\"\n                      >\n                        <Flame className=\"w-4 h-4\" />\n                        <span>\327\221\327\251\327\234 \327\225\327\222\327\250\327\242 \327\236\327\224\327\236\327\234\327\220\327\231 (STOCK_OUT)</span>\n                      </button>\n                    </div>\n                  </div>\n\n                  {/* Feedback on cook */}\n                  {cookingSuccess && cookingSuccess.id === dish.id && (\n                    <div className=\"p-3 bg-emerald-50 dark:bg-emerald-950/40 border border-emerald-200 dark:border-emerald-800 rounded-xl text-xs font-semibold text-emerald-800 dark:text-emerald-300 flex items-center gap-2\">\n                      <CheckCircle2 className=\"w-4 h-4 text-emerald-600\" />\n                      <span>{cookingSuccess.message}</span>\n                    </div>\n                  )}\n\n                  {/* Ingredients Breakdown Table */}\n                  <div>\n                    <h4 className=\"text-xs font-bold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-3\">\n                      \327\244\327\231\327\250\327\225\327\247 \327\227\327\225\327\236\327\250\327\231 \327\222\327\234\327\235 \327\236\327\225\327\234 \327\224\327\236\327\234\327\220\327\231 \327\224\327\247\327\231\327\231\327\235:\n                    </h4>\n\n                    <div className=\"overflow-x-auto\">\n                      <table className=\"w-full text-right text-xs\">\n                        <thead className=\"bg-zinc-50 dark:bg-zinc-750 border-b border-zinc-200 dark:border-zinc-700 text-zinc-500 font-semibold\">\n                          <tr>\n                            <th className=\"py-2.5 px-3\">\327\227\327\225\327\236\327\250 \327\222\327\234\327\235</th>\n                            <th className=\"py-2.5 px-3\">\327\241\327\234\327\225\327\230 \327\244\327\231\327\226\327\231</th>\n                            <th className=\"py-2.5 px-3\">\327\233\327\236\327\225\327\252 \327\223\327\250\327\225\327\251\327\224</th>\n                            <th className=\"py-2.5 px-3\">\327\226\327\236\327\231\327\237 \327\221\327\236\327\226\327\225\327\225\327\224</th>\n                            <th className=\"py-2.5 px-3 text-center\">\327\226\327\236\327\231\327\240\327\225\327\252</th>\n                          </tr>\n                        </thead>\n                        <tbody className=\"divide-y divide-zinc-200/60 dark:divide-zinc-700/50\">\n                          {dish.ingredients.map((ing, iIdx) => {\n                            const matched = inventory.find(\n                              (item) =>\n                                item.name.toLowerCase().includes(ing.itemName.toLowerCase()) ||\n                                ing.itemName.toLowerCase().includes(item.name.toLowerCase())\n                            );\n                            const isAvailable = matched && matched.quantity >= ing.quantity;\n\n                            return (\n                              <tr key={iIdx} className=\"hover:bg-zinc-50/50 dark:hover:bg-zinc-750/30\">\n                                <td className=\"py-2.5 px-3 font-semibold text-zinc-800 dark:text-zinc-200\">\n                                  {ing.itemName}\n                                </td>\n                                <td className=\"py-2.5 px-3\">\n                                  <span className=\"text-[11px] px-2 py-0.5 rounded bg-zinc-100 dark:bg-zinc-700 text-zinc-600 dark:text-zinc-300 font-mono\">\n                                    {matched?.slot || ing.slotHint || \'PANTRY\'}\n                                  </span>\n                                </td>\n                                <td className=\"py-2.5 px-3 font-mono font-medium\">\n                                  {ing.quantity} {ing.unit}\n                                </td>\n                                <td className=\"py-2.5 px-3 font-mono\">\n                                  {matched ? `${matched.quantity} ${matched.unit}` : \'0 (\327\227\327\241\327\250)\'}\n                                </td>\n                                <td className=\"py-2.5 px-3 text-center\">\n                                  {isAvailable ? (\n                                    <span className=\"inline-flex items-center gap-1 text-emerald-600 dark:text-emerald-400 font-bold text-[11px]\">\n                                      <CheckCircle2 className=\"w-3.5 h-3.5\" />\n                                      \327\226\327\236\327\231\327\237\n                                    </span>\n                                  ) : (\n                                    <span className=\"inline-flex items-center gap-1 text-rose-600 dark:text-rose-400 font-bold text-[11px]\">\n                                      <AlertCircle className=\"w-3.5 h-3.5\" />\n                                      \327\227\327\241\327\250\n                                    </span>\n                                  )}\n                                </td>\n                              </tr>\n                            );\n                          })}\n                        </tbody>\n                      </table>\n                    </div>\n                  </div>\n\n                  {/* Preparation Instructions */}\n                  {dish.instructions && dish.instructions.length > 0 && (\n                    <div>\n                      <h4 className=\"text-xs font-bold text-zinc-700 dark:text-zinc-300 uppercase tracking-wider mb-2 flex items-center gap-1.5\">\n                        <ListOrdered className=\"w-3.5 h-3.5 text-emerald-600\" />\n                        <span>\327\251\327\234\327\221\327\231 \327\224\327\233\327\240\327\224:</span>\n                      </h4>\n                      <ol className=\"list-decimal list-inside space-y-1.5 text-xs text-zinc-600 dark:text-zinc-300 pr-2\">\n                        {dish.instructions.map((step, sIdx) => (\n                          <li key={sIdx} className=\"leading-relaxed\">\n                            {step}\n                          </li>\n                        ))}\n                      </ol>\n                    </div>\n                  )}\n                </div>\n              );\n            })()}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
    }
