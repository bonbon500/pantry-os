\327\225\327\237 \327\242\327\240\327\237 \327\220\327\231\327\251\327\231.\n  - **Magic Link**: \327\233\327\240\327\231\327\241\327\224 \327\236\327\224\327\231\327\250\327\224 \327\225\327\236\327\220\327\225\327\221\327\230\327\227\327\252 \327\223\327\250\327\232 \327\247\327\231\327\251\327\225\327\250 \327\234\327\252\327\231\327\221\327\252 \327\224\327\223\327\225\327\220\"\327\234.\n- **\327\230\327\242\327\231\327\240\327\252 \327\241\327\251\327\237 \327\250\327\220\327\251\327\225\327\240\327\231**: \327\227\327\231\327\225\327\225\327\231 \327\220\327\240\327\231\327\236\327\230\327\231\327\221\327\231 \327\240\327\247\327\231 (\"\327\236\327\220\327\236\327\252 \327\241\327\251\327\237 \327\236\327\225\327\234 Supabase Auth...\") \327\251\327\236\327\225\327\240\327\242 \327\224\327\221\327\224\327\225\327\221\327\231\327\235 \327\234\327\244\327\240\327\231 \327\230\327\242\327\231\327\240\327\252 \327\224\327\241\327\251\327\237 \327\224\327\247\327\231\327\231\327\235.\n\n---\n\n### 2. \327\221\327\231\327\223\327\225\327\223 \327\225\327\241\327\240\327\233\327\250\327\225\327\237 \327\236\327\234\327\220\327\231 \327\234\327\244\327\231 `user_id`\n- **\327\230\327\242\327\231\327\240\327\224 \327\220\327\225\327\230\327\225\327\236\327\230\327\231\327\252 \327\221\327\242\327\252 \327\224\327\252\327\227\327\221\327\250\327\225\327\252**: \327\251\327\220\327\231\327\234\327\252\327\225\327\252 `inventory_items` \327\225-`shopping_list` \327\251\327\225\327\234\327\244\327\225\327\252 \327\220\327\232 \327\225\327\250\327\247 \327\220\327\252 \327\224\327\244\327\250\327\231\327\230\327\231\327\235 \327\224\327\236\327\251\327\225\327\231\327\233\327\231\327\235 \327\234-`user_id` \327\251\327\234 \327\224\327\236\327\251\327\252\327\236\327\251 \327\224\327\236\327\227\327\225\327\221\327\250.\n- **\327\251\327\236\327\231\327\250\327\224 \327\225\327\242\327\223\327\233\327\225\327\237 \327\227\327\231\327\231\327\235**: \327\233\327\234 \327\2