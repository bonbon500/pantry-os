27\225\327\240\327\231\327\235 \327\236\327\225\327\221\327\240\327\224):\n\n\360\237\222\254 \327\236\327\242\327\240\327\224 \327\231\327\251\327\231\327\250 / \327\241\327\231\327\233\327\225\327\235 \327\244\327\242\327\225\327\234\327\224:\n[\327\224\327\225\327\223\327\242\327\224 \327\247\327\246\327\250\327\224, \327\236\327\242\327\225\327\246\327\221\327\252 \327\225\327\221\327\250\327\225\327\250\327\224 \327\221\327\242\327\221\327\250\327\231\327\252 \327\242\327\235 \327\220\327\231\327\236\327\225\327\222\'\327\231\327\235 \327\242\327\234 \327\224\327\244\327\242\327\225\327\234\327\224 \327\251\327\221\327\225\327\246\327\242\327\224]\n\n\360\237\223\212 Payload \327\240\327\252\327\225\327\240\327\231\327\235 \327\234\327\236\327\242\327\250\327\233\327\252 (JSON):\n```json\n{\n  \"action_type\": \"STOCK_IN | STOCK_OUT | COOKING_PLAN | SHOPPING_SYNC | COPILOT_QUERY\",\n  \"inventory_mutations\": [\n    {\n      \"item_name\": \"\327\251\327\235 \327\224\327\244\327\250\327\231\327\230\",\n      \"barcode_or_sku\": \"\327\236\327\247\\\"\327\230 \327\220\327\225 null\",\n      \"quantity_delta\": 1,\n      \"unit_type\": \"\327\220\327\250\327\231\327\226\327\224 | \327\246\327\240\327\246\327\240\327\252 | \327\247\327\225\327\244\327\241\327\224 | \327\231\327\227\'\",\n      \"target_slot\": \"JAR_COLUMN_1 | CANNED_COLUMN_2 | KANBAN_BACKUP_3 | UTILITY_DRAWER_1 | UTILITY_DRAWER_2 | FRESH_OR_REFRIGERATED | GARDEN_HERBS\",\n      \"resulting_status\": \"IN_STOCK | LOW | EMPTY\"\n    }\n  ],\n  \"shopping_list_additions\": [\n    {\n      \"item_name\": \"\327\251\327\235 \327\224\327\236\327\225\327\246\327\250 \327\251\327\227\327\241\327\250\",\n      \"search_query\": \"\327\236\327\225\327\240\327\227 \327\227\327\231\327\244\327\225\327\251 \327\236\327\223\327\225\327\231\327\247 \327\234\327\247\327\230\327\234\327\225\327\222\",\n      \"quantity_needed\": 1,\n      \"estimated_price\": 0.0,\n      \"department\": \"PANTRY | PRODUCE | REFRI