        }
        lines {
          text: "  const isStockOut = lowerPrompt.includes(\'\327\241\327\231\327\231\327\236\327\252\327\231\') || lowerPrompt.includes(\'\327\224\327\251\327\252\327\236\327\251\327\252\327\231\') || lowerPrompt.includes(\'\327\222\327\250\327\231\327\242\327\224\') || lowerPrompt.includes(\'\327\240\327\222\327\236\327\250\') || lowerPrompt.includes(\'\327\250\327\231\327\247\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const isCooking = lowerPrompt.includes(\'\327\234\327\221\327\251\327\234\') || lowerPrompt.includes(\'\327\236\327\252\327\233\327\225\327\237\') || lowerPrompt.includes(\'\327\236\327\240\327\224\') || lowerPrompt.includes(\'\327\242\327\250\327\221\') || lowerPrompt.includes(\'\327\246\327\224\327\250\327\231\327\231\327\235\') || lowerPrompt.includes(\'\327\251\327\247\327\251\327\225\327\247\327\224\') || lowerPrompt.includes(\'\327\244\327\241\327\230\327\224\') || lowerPrompt.includes(\'\327\236\327\225\327\247\327\244\327\245\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const isShopping = lowerPrompt.includes(\'\327\247\327\240\327\231\327\225\327\252\') || lowerPrompt.includes(\'\327\227\327\241\327\250\') || lowerPrompt.includes(\'\327\241\327\225\327\244\327\250\') || lowerPrompt.includes(\'\327\250\327\251\327\231\327\236\327\224\');"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  const isReceipt = inputType === \'receipt_ocr\' || cleanPrompt.includes(\'\327\251\327\225\327\244\327\250\327\241\327\234\') || cleanPrompt.includes(\'\327\250\327\236\327\231 \327\234\327\225\327\231\') || cleanPrompt.includes(\'\327\236\327\247\327\264\327\230\') || cleanPrompt.includes(\'729000\');"
