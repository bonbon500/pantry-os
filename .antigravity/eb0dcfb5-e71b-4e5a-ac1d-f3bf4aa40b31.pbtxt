  file_change {
    absolute_path_uri: "file:///src/components/ShoppingBranchView.tsx"
    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { usePantry } from \'../context/PantryContext\';\nimport { ShoppingListItem } from \'../types\';\nimport {\n  ShoppingCart,\n  CheckSquare,\n  Square,\n  Search,\n  ExternalLink,\n  Copy,\n  Check,\n  Plus,\n  Trash2,\n  ArrowDownCircle,\n  Tag,\n  Store,\n  DollarSign,\n} from \'lucide-react\';\n\nexport const ShoppingBranchView: React.FC = () => {\n  const {\n    shoppingList,\n    toggleShoppingItem,\n    removeShoppingItem,\n    addShoppingItem,\n    convertShoppingItemToStock,\n    convertAllPurchasedToStock,\n  } = usePantry();\n\n  const [newItemName, setNewItemName] = useState(\'\');\n  const [newDepartment, setNewDepartment] = useState<\'PRODUCE\' | \'PANTRY\' | \'REFRIGERATED\' | \'UTILITY\'>(\'PANTRY\');\n  const [copiedQueryId, setCopiedQueryId] = useState<string | null>(null);\n\n  const purchasedCount = shoppingList.filter((i) => i.isPurchased).length;\n  const unpurchasedCount = shoppingList.filter((i) => !i.isPurchased).length;\n  const totalEstimatedCost = shoppingList\n    .filter((i) => !i.isPurchased)\n    .reduce((sum, item) => sum + (item.estimated_price || 0), 0);\n\n  const handleCopySearchQuery = (item: ShoppingListItem) => {\n    navigator.clipboard.writeText(item.search_query);\n    setCopiedQueryId(item.id);\n    setTimeout(() => setCopiedQueryId(null), 2000);\n  };\n\n  const handleAddManual = (e: React.FormEvent) => {\n    e.preventDefault();\n    if (!newItemName.trim()) return;\n\n    addShoppingItem({\n      item_name: newItemName.trim(),\n      search_query: newItemName.trim(),\n      quantity_needed: 1,\n      estimated_price: 12.0,\n      department: newDepartment,\n      reason: \'\327\224\327\225\327\241\327\244\327\224 \327\231\327\223\327\240\327\231\327\252 \327\234\327\241\327\234 \327\227\327\225\327\241\327\250\327\231\327\235\',\n      isPurchased: false,\n    });\n\n    setNewItemName(\'\');\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Header Banner & Stats */}\n      <div className=\"grid grid-cols-1 md:grid-cols-3 gap-4\">\n        <div className=\"bg-white dark:bg-zinc-800 p-4 rounded-2xl border border-zinc-200 dark:border-zinc-700 shadow-xs\">\n          <div className=\"text-xs text-zinc-500 font-medium\">\327\244\327\250\327\231\327\230\327\231\327\235 \327\227\327\241\327\250\327\231\327\235 \327\221\327\241\327\234</div>\n          <div className=\"text-2xl font-bold text-rose-600 dark:text-rose-400 mt-1\">\n            {unpurchasedCount} \327\244\327\250\327\231\327\230\327\231\327\235\n          </div>\n          <div className=\"text-xs text-zinc-400 mt-1\">\n            \327\236\327\221\327\225\327\241\327\241 \327\220\327\232 \327\225\327\250\327\247 \327\242\327\234 \327\227\327\225\327\241\327\250\327\231\327\235 \327\225\327\236\327\240\327\225\327\252 \327\236\327\252\327\225\327\233\327\240\327\240\327\225\327\252\n          </div>\n        </div>\n\n        <div className=\"bg-white dark:bg-zinc-800 p-4 rounded-2xl border border-zinc-200 dark:border-zinc-700 shadow-xs\">\n          <div className=\"text-xs text-zinc-500 font-medium\">\327\220\327\225\327\236\327\223\327\237 \327\242\327\234\327\225\327\252 \327\236\327\251\327\225\327\242\327\250\327\252</div>\n          <div className=\"text-2xl font-bold text-zinc-900 dark:text-white mt-1\">\n            \342\202\252{totalEstimatedCost.toFixed(2)}\n          </div>\n          <div className=\"text-xs text-zinc-400 mt-1 flex items-center gap-1\">\n            <DollarSign className=\"w-3 h-3 text-emerald-500\" />\n            <span>\327\234\327\244\327\231 \327\236\327\227\327\231\327\250\327\231 \327\236\327\236\327\225\327\246\327\242 \327\247\327\230\327\234\327\225\327\222 \327\241\327\225\327\244\327\250</span>\n          </div>\n        </div>\n\n        <div className=\"bg-white dark:bg-zinc-800 p-4 rounded-2xl border border-zinc-200 dark:border-zinc-700 shadow-xs flex flex-col justify-between\">\n          <div>\n            <div className=\"text-xs text-emerald-600 font-medium\">\327\241\327\225\327\236\327\240\327\225 \327\233\327\240\327\250\327\233\327\251\327\225</div>\n            <div className=\"text-2xl font-bold text-emerald-600 mt-1\">{purchasedCount} \327\244\327\250\327\231\327\230\327\231\327\235</div>\n          </div>\n          {purchasedCount > 0 && (\n            <button\n              onClick={convertAllPurchasedToStock}\n              id=\"btn-convert-all-stock\"\n              className=\"mt-2 w-full py-1.5 bg-emerald-600 hover:bg-emerald-700 active:bg-emerald-800 text-white font-bold text-xs rounded-lg flex items-center justify-center gap-1.5 transition-colors shadow-xs\"\n            >\n              <ArrowDownCircle className=\"w-3.5 h-3.5\" />\n              <span>\327\224\327\242\327\221\327\250 \327\220\327\252 \327\233\327\234 \327\224\327\236\327\241\327\225\327\236\327\240\327\231\327\235 \327\234\327\236\327\234\327\220\327\231 (STOCK_IN)</span>\n            </button>\n          )}\n        </div>\n      </div>\n\n      {/* Manual Quick Add Form */}\n      <form\n        onSubmit={handleAddManual}\n        className=\"bg-white dark:bg-zinc-800/80 p-3.5 rounded-xl border border-zinc-200 dark:border-zinc-700 flex flex-col sm:flex-row items-center gap-2.5\"\n      >\n        <div className=\"relative flex-1 w-full\">\n          <input\n            type=\"text\"\n            value={newItemName}\n            onChange={(e) => setNewItemName(e.target.value)}\n            placeholder=\"\327\224\327\225\327\241\327\243 \327\236\327\225\327\246\327\250 \327\227\327\241\327\250 \327\231\327\223\327\240\327\231\327\252 (\327\234\327\236\327\251\327\234: \'\327\251\327\236\327\237 \327\247\327\225\327\247\327\225\327\241 500 \327\236\327\264\327\234\')...\"\n            className=\"w-full pl-3 pr-3 py-2 text-xs bg-zinc-50 dark:bg-zinc-700/60 border border-zinc-200 dark:border-zinc-700 rounded-lg text-zinc-900 dark:text-white placeholder-zinc-400 focus:outline-none focus:ring-2 focus:ring-emerald-500/40\"\n          />\n        </div>\n\n        <select\n          value={newDepartment}\n          onChange={(e: any) => setNewDepartment(e.target.value)}\n          className=\"py-2 px-3 text-xs bg-zinc-50 dark:bg-zinc-700/60 border border-zinc-200 dark:border-zinc-700 rounded-lg text-zinc-800 dark:text-zinc-200 focus:outline-none\"\n        >\n          <option value=\"PANTRY\">\327\236\327\226\327\225\327\225\327\224 \327\231\327\221\327\251 (PANTRY)</option>\n          <option value=\"PRODUCE\">\327\231\327\250\327\247\327\225\327\252 \327\225\327\244\327\231\327\250\327\225\327\252 (PRODUCE)</option>\n          <option value=\"REFRIGERATED\">\327\236\327\246\327\225\327\240\327\237 \327\225\327\236\327\247\327\250\327\250 (REFRIGERATED)</option>\n          <option value=\"UTILITY\">\327\227\327\223-\327\244\327\242\327\236\327\231 \327\225\327\236\327\251\327\247 \327\221\327\231\327\252 (UTILITY)</option>\n        </select>\n\n        <button\n          type=\"submit\"\n          className=\"w-full sm:w-auto px-4 py-2 bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 text-xs font-bold rounded-lg flex items-center justify-center gap-1 hover:opacity-90 transition-opacity\"\n        >\n          <Plus className=\"w-3.5 h-3.5\" />\n          <span>\327\224\327\225\327\241\327\243 \327\234\327\227\327\225\327\241\327\250\327\231\327\235</span>\n        </button>\n      </form>\n\n      {/* Shopping List Items */}\n      <div className=\"bg-white dark:bg-zinc-800 rounded-2xl border border-zinc-200 dark:border-zinc-700 shadow-xs overflow-hidden\">\n        <div className=\"p-4 border-b border-zinc-200 dark:border-zinc-700 flex items-center justify-between\">\n          <div className=\"flex items-center gap-2\">\n            <ShoppingCart className=\"w-4 h-4 text-emerald-600\" />\n            <h3 className=\"font-bold text-sm text-zinc-900 dark:text-white\">\n              \327\250\327\251\327\231\327\236\327\252 \327\247\327\240\327\231\327\225\327\252 \327\223\327\231\327\240\327\236\327\231\327\252 \327\225\327\251\327\220\327\231\327\234\327\252\327\225\327\252 \327\227\327\231\327\244\327\225\327\251 \327\234\327\247\327\230\327\234\327\225\327\222\n            </h3>\n          </div>\n          <span className=\"text-xs text-zinc-400\">\n            {shoppingList.length} \327\241\327\224\327\264\327\233 \327\244\327\250\327\231\327\230\327\231\327\235\n          </span>\n        </div>\n\n        {shoppingList.length === 0 ? (\n          <div className=\"text-center py-12 text-zinc-400 text-xs space-y-2\">\n            <Check className=\"w-8 h-8 mx-auto text-emerald-500/50\" />\n            <p>\327\220\327\231\327\237 \327\227\327\225\327\241\327\250\327\231\327\235 \327\233\327\250\327\222\327\242! \327\233\327\234 \327\224\327\236\327\226\327\225\327\225\327\224 \327\225\327\224\327\236\327\247\327\250\327\250 \327\236\327\234\327\220\327\231\327\235 \327\234\327\251\327\221\327\231\327\242\327\225\327\252 \327\250\327\246\327\225\327\240\327\232.</p>\n          </div>\n        ) : (\n          <div className=\"divide-y divide-zinc-200/70 dark:divide-zinc-700/60\">\n            {shoppingList.map((item) => (\n              <div\n                key={item.id}\n                id={`shop-item-${item.id}`}\n                className={`p-4 flex flex-col sm:flex-row sm:items-center justify-between gap-3 transition-colors ${\n                  item.isPurchased ? \'bg-zinc-50/70 dark:bg-zinc-850/40 opacity-70\' : \'hover:bg-zinc-50/50\'\n                }`}\n              >\n                {/* Checkbox and Item info */}\n                <div className=\"flex items-start gap-3\">\n                  <button\n                    onClick={() => toggleShoppingItem(item.id)}\n                    className=\"mt-0.5 text-emerald-600 hover:text-emerald-700 transition-colors\"\n                  >\n                    {item.isPurchased ? (\n                      <CheckSquare className=\"w-5 h-5\" />\n                    ) : (\n                      <Square className=\"w-5 h-5 text-zinc-400\" />\n                    )}\n                  </button>\n\n                  <div>\n                    <div className=\"flex items-center gap-2\">\n                      <span\n                        className={`font-bold text-sm text-zinc-900 dark:text-white ${\n                          item.isPurchased ? \'line-through text-zinc-400\' : \'\'\n                        }`}\n                      >\n                        {item.item_name}\n                      </span>\n                      <span className=\"text-xs px-2 py-0.2 rounded font-mono bg-zinc-100 dark:bg-zinc-700 text-zinc-600 dark:text-zinc-300\">\n                        x{item.quantity_needed} {item.unit || \'\327\231\327\227\327\263\'}\n                      </span>\n                      <span className=\"text-[10px] px-2 py-0.2 rounded font-semibold bg-emerald-50 text-emerald-700 dark:bg-emerald-950/60 dark:text-emerald-300 border border-emerald-200 dark:border-emerald-800\">\n                        {item.department}\n                      </span>\n                    </div>\n\n                    <div className=\"text-xs text-zinc-500 dark:text-zinc-400 mt-1 flex flex-wrap items-center gap-3\">\n                      <span>\327\241\327\231\327\221\327\224: {item.reason}</span>\n                      {item.estimated_price > 0 && (\n                        <span>\327\220\327\225\327\236\327\223\327\237: \342\202\252{item.estimated_price.toFixed(1)}</span>\n                      )}\n                    </div>\n                  </div>\n                </div>\n\n                {/* Supermarket Search Query Box */}\n                <div className=\"flex items-center gap-2 self-end sm:self-center\">\n                  <div className=\"flex items-center bg-zinc-100 dark:bg-zinc-700/60 rounded-lg px-2.5 py-1 text-xs border border-zinc-200 dark:border-zinc-600\">\n                    <Store className=\"w-3 h-3 text-zinc-400 ml-1.5\" />\n                    <span className=\"font-mono text-[11px] text-zinc-700 dark:text-zinc-300 max-w-[140px] truncate\">\n                      {item.search_query}\n                    </span>\n                    <button\n                      onClick={() => handleCopySearchQuery(item)}\n                      title=\"\327\224\327\242\327\252\327\247 \327\251\327\220\327\231\327\234\327\252\327\252 \327\227\327\231\327\244\327\225\327\251 \327\234\327\241\327\225\327\244\327\250\"\n                      className=\"mr-1.5 p-1 hover:bg-zinc-200 dark:hover:bg-zinc-600 rounded text-zinc-500\"\n                    >\n                      {copiedQueryId === item.id ? (\n                        <Check className=\"w-3 h-3 text-emerald-600\" />\n                      ) : (\n                        <Copy className=\"w-3 h-3\" />\n                      )}\n                    </button>\n                  </div>\n\n                  {item.isPurchased && (\n                    <button\n                      onClick={() => convertShoppingItemToStock(item.id)}\n                      title=\"\327\224\327\242\327\221\327\250 \327\234\327\241\327\234\327\225\327\230 \327\224\327\236\327\252\327\220\327\231\327\235 \327\221\327\236\327\226\327\225\327\225\327\224 (STOCK_IN)\"\n                      className=\"px-2.5 py-1 text-xs font-semibold bg-emerald-600 hover:bg-emerald-700 text-white rounded-lg flex items-center gap-1 shadow-xs\"\n                    >\n                      <ArrowDownCircle className=\"w-3.5 h-3.5\" />\n                      <span className=\"hidden sm:inline\">\327\234\327\236\327\226\327\225\327\225\327\224</span>\n                    </button>\n                  )}\n\n                  <button\n                    onClick={() => removeShoppingItem(item.id)}\n                    className=\"p-1.5 text-zinc-400 hover:text-rose-600 transition-colors\"\n                  >\n                    <Trash2 className=\"w-4 h-4\" />\n                  </button>\n                </div>\n              </div>\n            ))}\n          </div>\n        )}\n      </div>\n    </div>\n  );\n};\n"
