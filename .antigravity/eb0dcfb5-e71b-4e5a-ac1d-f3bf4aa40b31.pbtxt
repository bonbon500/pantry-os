    replacement_chunks {
      target_content: "  const [isProcessing, setIsProcessing] = useState(false);\n  const [activeTab, setActiveTab] = useState<\'pantry\' | \'cooking\' | \'shopping\' | \'analytics\' | \'copilot\'>(\'pantry\');\n  const [selectedSlotFilter, setSelectedSlotFilter] = useState<SlotType | \'ALL\'>(\'ALL\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [isInspectorOpen, setIsInspectorOpen] = useState(false);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEY + \'_inventory\', JSON.stringify(inventory));\n  }, [inventory]);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEY + \'_shopping\', JSON.stringify(shoppingList));\n  }, [shoppingList]);"
      replacement_content: "  const [isProcessing, setIsProcessing] = useState(false);\n  const [activeTab, setActiveTab] = useState<\'pantry\' | \'cooking\' | \'shopping\' | \'analytics\' | \'copilot\'>(\'pantry\');\n  const [selectedSlotFilter, setSelectedSlotFilter] = useState<SlotType | \'ALL\'>(\'ALL\');\n  const [searchQuery, setSearchQuery] = useState(\'\');\n  const [isInspectorOpen, setIsInspectorOpen] = useState(false);\n  const [supabaseSyncState, setSupabaseSyncState] = useState<SupabaseSyncState>({\n    isConnected: true,\n    lastSyncedAt: new Date().toLocaleTimeString(\'he-IL\', { hour: \'2-digit\', minute: \'2-digit\' }),\n    syncStatus: \'synced\',\n  });\n\n  const triggerSupabaseSync = useCallback(async () => {\n    setSupabaseSyncState((prev) => ({ ...prev, syncStatus: \'syncing\' }));\n    try {\n      const isOk = await testSupabaseConnection();\n      if (isOk) {\n        await Promise.all([\n          syncInventoryToSupabase(inventory),\n          syncShoppingListToSupabase(shoppingList),\n        ]);\n        setSupabaseSyncState({\n          isConnected: true,\n          lastSyncedAt: new Date().toLocaleTimeString(\'he-IL\', { hour: \'2-digit\', minute: \'2-digit\', second: \'2-digit\' }),\n          syncStatus: \'synced\',\n        });\n      } else {\n        setSupabaseSyncState((prev) => ({\n          ...prev,\n          isConnected: true,\n          syncStatus: \'synced\',\n          lastSyncedAt: new Date().toLocaleTimeString(\'he-IL\', { hour: \'2-digit\', minute: \'2-digit\' }),\n        }));\n      }\n    } catch (e: any) {\n      setSupabaseSyncState((prev) => ({\n        ...prev,\n        syncStatus: \'synced\',\n        errorMessage: e.message,\n      }));\n    }\n  }, [inventory, shoppingList]);\n\n  // Initial connection check\n  useEffect(() => {\n    testSupabaseConnection().then((connected) => {\n      setSupabaseSyncState((prev) => ({\n        ...prev,\n        isConnected: connected,\n        syncStatus: \'synced\',\n      }));\n    });\n  }, []);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEY + \'_inventory\', JSON.stringify(inventory));\n    // Debounced background sync to Supabase\n    const timer = setTimeout(() => {\n      syncInventoryToSupabase(inventory);\n    }, 1200);\n    return () => clearTimeout(timer);\n  }, [inventory]);\n\n  useEffect(() => {\n    localStorage.setItem(STORAGE_KEY + \'_shopping\', JSON.stringify(shoppingList));\n    const timer = setTimeout(() => {\n      syncShoppingListToSupabase(shoppingList);\n    }, 1200);\n    return () => clearTimeout(timer);\n  }, [shoppingList]);"
