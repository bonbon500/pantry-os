40\327\243 \327\224\327\236\327\234\327\220\327\231 (\327\234\327\231\327\223 \327\236\327\242\327\221\327\250 \327\224\327\252\327\246\327\225\327\222\327\225\327\252).\n- **\327\233\327\244\327\252\327\225\327\250 \327\236\327\224\327\231\327\250 \"\327\224\327\225\327\241\327\243 \327\234\327\241\327\234\327\225\327\230 \327\226\327\224\"**: \327\236\327\225\327\244\327\231\327\242 \327\221\327\250\327\220\327\251 \327\233\327\234 \327\220\327\227\327\223 \327\236-7 \327\224\327\241\327\234\327\225\327\230\327\231\327\235 \327\224\327\244\327\231\327\226\327\231\327\231\327\235 \327\225\327\233\327\237 \327\221\327\236\327\246\327\221 \327\251\327\221\327\225 \327\241\327\234\327\225\327\230 \327\250\327\231\327\247, \327\225\327\236\327\222\327\223\327\231\327\250 \327\236\327\250\327\220\327\251 \327\220\327\252 \327\224\327\241\327\234\327\225\327\230, \327\224\327\236\327\227\327\234\327\247\327\224 \327\225\327\231\327\227\327\231\327\223\327\252 \327\224\327\236\327\231\327\223\327\224 \327\224\327\236\327\252\327\220\327\231\327\236\327\224.\n- **\327\230\327\225\327\244\327\241 \327\224\327\225\327\241\327\244\327\224 \327\227\327\233\327\235**: \327\236\327\220\327\244\327\251\327\250 \327\224\327\226\327\240\327\252 \327\251\327\235, \327\233\327\236\327\225\327\231\327\225\327\252, \327\250\327\243 \327\252\327\227\327\252\327\225\327\237, \327\221\327\250\327\247\327\225\327\223, \327\236\327\227\327\231\327\250 \327\225\327\224\327\242\327\250\327\225\327\252 \327\221\327\234\327\227\327\231\327\246\327\252 \327\233\327\244\327\252\327\225\327\250 \327\220\327\227\327\252.\n\n---\n\n### 3. \327\224\327\222\327\223\327\250\327\252 \327\250\327\243 \327\252\327\227\327\252\327\225\327\237 \327\234\327\236\327\234\327\220\327\231 (Minimum Stock Threshold)\n- **\327\250\327\243 \327\236\327\225\327\252\327\220\327\235 \327\234\327\233\327\234 \327\236\327\225\327\246\327\250**: \327\240\327\231\327\252\327\237 \327\234\327\224\327\222\327\223\327\231\327\250 \327\234\327\233\327\234 \327\244\327\250\327\231\327\230 \327\233\327\236\327\225\327\252 \327\236\327\231\327\240\327\231\327\236\327\225\327\235 \327\236\327\221\327\225\327\247\327\251\327\252 (\327\234\327\236\327\251\327\234: \327\241\327\243 \327\251\327\234 2 \327\227\327\221\327\231\327\234\327\225\327\252 \327\220\327\225 3 \327\246\327\240\327\246\327\240\327\225\327\252).\n- **\327\224\327\252\327\250\327\220\327\224 \327\227\327\226\327\225\327\252\327\231\327\252 \327\225\327\227\327\231\327\251\327\225\327\221 \327\241\327\230\327\230\327\225\327\241 \327\220\327\225\327\230\327\225\327\236\327\230\327\231**:\n  - \327\233\327\220\327\251\327\250 \327\224\327\233\327\236\327\225\327\252 \327\231\327\225\327\250\327\223\327\252 \327\234\327\250\327\243 \327\224\327\252\327\227\327\252\327\225\327\237 \327\225\327\236\327\230\327\224 \342\200\223 \327\224\327\236\327\225\327\246\327\250 \327\236\327\247\327\221\327\234 \327\252\327\222 `\327\236\327\252\327\227\327\252 \327\234\327\241\327\243` \327\225\327\240\327\246\327\221\327\242 \327\221\327\220\327\226\327\224\327\250\327\252 \327\246\327\224\327\225\327\221/\327\233\327\252\327\225\327\235 `LOW`.\n  - \327\233\327\220\327\251\327\250 \327\224\327\233\327\236\327\225\327\252 \327\236\327\222\327\231\327\242\327\224 \327\234-0 \342\200\223 \327\224\327\236\327\225\327\246\327\250 \327\236\327\241\327\225\327\236\327\237 \327\233-`EMPTY` (\327\220\327\226\327\234).\n- **\327\241\327\240\327\233\327\250\327\225\327\237 \327\227\327\225\327\241\327\250\327\231\327\235 \327\236\327\250\327\225\327\233\327\226**: \327\240\327\225\327\241\327\243 \327\233\327\244\327\252\327\225\327\250 \327\224\327\252\327\250\327\220\327\224 \327\236\327\250\327\225\327\233\327\226 \327\221\327\250\327\220\327\251 \327\224\327\223\327\243 \342\200\223 **\"\327\224\327\242\327\221\327\250 \327\220\327\252 \327\233\327\234 \327\224\327\227\327\225\327\241\327\250\327\231\327\235 \327\234\327\241\327\234 \327\224\32