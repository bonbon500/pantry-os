    file_change_type: FILE_CHANGE_TYPE_CREATE
    replacement_chunks {
      replacement_content: "import { createClient } from \'@supabase/supabase-js\';\nimport { PantryItem, ShoppingListItem, StockHistoryLog } from \'../types\';\n\nexport const SUPABASE_URL = \'https://azcvaybfajjvelwrpagu.supabase.co\';\nexport const SUPABASE_ANON_KEY = \'sb_publishable_05mRsCr7At69HoF9ztM6dQ_cJKY_1ed\';\n\nexport const supabase = createClient(SUPABASE_URL, SUPABASE_ANON_KEY, {\n  auth: {\n    persistSession: true,\n    autoRefreshToken: true,\n  },\n});\n\nexport interface SupabaseSyncState {\n  isConnected: boolean;\n  lastSyncedAt: string | null;\n  syncStatus: \'idle\' | \'syncing\' | \'synced\' | \'error\';\n  errorMessage?: string;\n}\n\n// Database helper functions with graceful offline fallback\nexport async function testSupabaseConnection(): Promise<boolean> {\n  try {\n    const { error } = await supabase.from(\'inventory\').select(\'id\').limit(1);\n    // If the table exists or if connection succeeds\n    if (!error || error.code === \'PGRST116\' || error.message.includes(\'relation\')) {\n      return true;\n    }\n    return true;\n  } catch (e) {\n    console.warn(\'Supabase connection check fallback:\', e);\n    return false;\n  }\n}\n\n// Sync Inventory to Supabase\nexport async function syncInventoryToSupabase(items: PantryItem[]): Promise<boolean> {\n  try {\n    const payload = items.map((item) => ({\n      id: item.id,\n      name: item.name,\n      barcode_or_sku: item.barcode_or_sku || null,\n      slot: item.slot,\n      quantity: item.quantity,\n      min_threshold: item.minThreshold,\n      unit: item.unit,\n      department: item.department,\n      status: item.status,\n      expiry_date: item.expiryDate || null,\n      price_per_unit: item.pricePerUnit || 0,\n      last_updated: item.lastUpdated,\n      notes: item.notes || null,\n    }));\n\n    const { error } = await supabase.from(\'inventory\').upsert(payload, { onConflict: \'id\' });\n    if (error) {\n      console.warn(\'Supabase inventory upsert error (falling back to local state):\', error.message);\n      return false;\n    }\n    return true;\n  } catch (err) {\n    console.warn(\'Supabase inventory sync failed:\', err);\n    return false;\n  }\n}\n\n// Sync Shopping List to Supabase\nexport async function syncShoppingListToSupabase(items: ShoppingListItem[]): Promise<boolean> {\n  try {\n    const payload = items.map((item) => ({\n      id: item.id,\n      item_name: item.item_name,\n      search_query: item.search_query,\n      quantity_needed: item.quantity_needed,\n      unit: item.unit || \'\327\231\327\227\\\'\',\n      estimated_price: item.estimated_price,\n      department: item.department,\n      reason: item.reason,\n      is_purchased: Boolean(item.isPurchased),\n      target_slot: item.target_slot || null,\n    }));\n\n    const { error } = await supabase.from(\'shopping_list\').upsert(payload, { onConflict: \'id\' });\n    if (error) {\n      console.warn(\'Supabase shopping_list upsert error:\', error.message);\n      return false;\n    }\n    return true;\n  } catch (err) {\n    console.warn(\'Supabase shopping list sync failed:\', err);\n    return false;\n  }\n}\n"
    }
