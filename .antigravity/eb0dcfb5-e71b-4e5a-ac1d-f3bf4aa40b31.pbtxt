          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "import { usePantry } from \'../context/PantryContext\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "import { PHYSICAL_SLOTS } from \'../data/slotDefinitions\';"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
