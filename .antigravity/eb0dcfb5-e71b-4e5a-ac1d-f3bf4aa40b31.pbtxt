    user_response: "\327\242\327\223\327\233\327\237 \327\220\327\252 \327\224\327\220\327\244\327\234\327\231\327\247\327\246\327\231\327\224 \327\234\327\244\327\231 \327\250\327\251\327\231\327\236\327\252 \327\224\327\252\327\231\327\247\327\225\327\240\327\231\327\235 \327\224\327\236\327\223\327\225\327\231\327\247\327\252 \327\224\327\221\327\220\327\224:\n\n1. \327\242\327\240\327\243 \327\236\327\234\327\220\327\231 (\327\233\327\250\327\230\327\231\327\241\327\231\327\225\327\252 \327\244\327\250\327\231\327\230 \327\225\327\231\327\227\327\231\327\223\327\225\327\252 \327\220\327\250\327\231\327\226\327\224):\n   - \327\231\327\227\327\231\327\223\327\225\327\252 \327\236\327\231\327\223\327\224 \327\244\327\251\327\225\327\230\327\225\327\252: \327\224\327\236\327\234\327\220\327\231 \327\231\327\240\327\225\327\224\327\234 \327\220\327\232 \327\225\327\250\327\247 \327\234\327\244\327\231 \327\220\327\250\327\231\327\226\327\225\327\252/\327\231\327\227\327\231\327\223\327\225\327\252 (\327\234\327\236\327\251\327\234: \"1 \327\246\327\240\327\246\327\240\327\252\", \"2 \327\247\327\225\327\244\327\241\327\220\327\225\327\252\", \"1 \327\251\327\247\327\231\327\252\", \"3 \327\231\327\227\'\") \342\200\224 \327\234\327\234\327\220 \327\227\327\231\327\251\327\225\327\221\327\231 \327\222\327\250\327\236\327\231\327\235 \327\220\327\225 \327\236\327\251\327\247\327\234\327\231\327\235 \327\236\327\225\327\250\327\233\327\221\327\231\327\235.\n   - \327\233\327\250\327\230\327\231\327\241\327\231\327\231\327\252 \327\244\327\250\327\231\327\230 \327\244\327\240\327\231\327\236\327\231\327\252 (Item Detail Modal / Drawer): \327\234\327\227\327\231\327\246\327\224 \327\242\327\234 \327\233\327\234 \327\244\327\250\327\231\327\230 \327\221\327\236\327\234\327\220\327\231 \327\244\327\225\327\252\327\227\327\252 \327\233\327\250\327\230\327\231\327\241\327\231\327\231\327\224 \327\231\327\231\327\242\327\225\327\223\327\231\327\252 \327\242\327\235:\n     \342\200\242 \327\251\327\235 \327\224\327\244\327\250\327\231\327\230 \327\225\327\224\327\241\327\234\327\225\327\230 \327\224\327\244\327\231\327\226\327\231 \327\251\327\234\327\225 \327\221\327\236\327\226\327\225\327\225\327\224.\n     \342\200\242 \327\233\327\236\327\225\327\252 \327\220\327\250\327\231\327\226\327\225\327\252 \327\240\327\225\327\233\327\227\327\231\327\252 \327\242\327\235 \327\233\327\244\327\252\327\225\327\250\327\231 \327\244\327\234\327\225\327\241/\327\236\327\231\327\240\327\225\327\241 \327\236\327\224\327\231\327\250\327\231\327\235 (+ / -).\n     \342\200\242 \327\241\327\230\327\230\327\225\327\241 \327\252\327\225\327\247\327\243 \327\220\327\225 \327\224\327\242\327\250\327\224 \327\247\327\246\327\250\327\224.\n     \342\200\242 \327\233\327\244\327\252\327\225\327\250 \327\236\327\224\327\231\327\250: \"\327\224\327\242\327\221\327\250 \327\234\327\227\327\225\327\241\327\250\327\231\327\235 \327\221\327\250\327\251\327\231\327\236\327\252 \327\247\327\240\327\231\327\225\327\252\".\n\n2. \327\242\327\240\327\243 \327\221\327\231\327\251\327\225\327\234 (\327\252\327\233\327\240\327\225\327\237, \327\244\327\231\327\250\327\225\327\247 \327\234\327\222\327\225\327\250\327\236\327\231\327\235 \327\225\327\222\327\250\327\231\327\242\327\224 \327\234\327\220\327\227\327\250 \327\221\327\231\327\246\327\225\327\242):\n   - \327\224\327\225\327\241\327\243 \327\220\327\226\327\225\327\250 \327\247\327\234\327\230 \327\236\327\224\327\231\327\250 (\327\252\327\231\327\221\327\252 \327\230\327\247\327\241\327\230 + \327\233\327\244\327\252\327\225\327\250 \327\224\327\247\327\234\327\230\327\224 \327\247\327\225\327\234\327\231\327\252) \327\234\327\224\327\226\327\240\327\252 \327\252\327\225\327\233\327\240\327\231\327\225\327\252 \327\224\327\221\327\231\327\251\327\225\327\234 (\327\234\327\223\327\225\327\222\327\236\327\224: \"\327\236\327\233\327\231\327\237 \327\236\327\225\327\247\327\244\327\245 \327\230\327\225\327\244\327\225 \327\225\327\247\327\231\327\251\327\225\327\220\327\231\327\235 \327\225\327\227\327\236\327\231\327\237 \327\221\327\225\327\250\327\222\327\225\327\234\").\n   - \327\240\327\231\327\252\327\225\327\227 \327\250\327\233\327\231\327\221\327\231\327\235 \327\236\327\225\327\234 \327\236\327\246\327\220\327\231: \327\224\327\236\327\242\327\250\327\233\327\252 \327\236\327\244\327\250\327\247\327\252 \327\220\327\252 \327\224\327\236\327\240\327\224 \327\234\327\250\327\233\327\231\327\221\327\231\327\235 \327\225\327\236\327\246\327\231\327\222\327\224 \327\241\327\230\327\230\327\225\327\241 \327\236\327\231\327\231\327\223\327\231 \327\234\327\233\327\234 \327\250\327\233\327\231\327\221:\n     \342\200\242 \342\234\205 \327\247\327\231\327\231\327\235 \327\221\327\236\327\234\327\220\327\231 (\327\220\327\231\327\226\327\225 \327\220\327\250\327\231\327\226\327\224/\327\241\327\234\327\225\327\230).\n     \342\200\242 \342\235\214 \327\227\327\241\327\250 \327\221\327\236\327\234\327\220\327\231 \342\200\224 \327\236\327\231\327\231\327\246\327\250 \327\220\327\225\327\230\327\225\327\236\327\230\327\231\327\252 \327\251\327\225\327\250\327\252 \327\244\327\250\327\231\327\230 \327\221\327\242\327\240\327\243 \327\224\327\247\327\240\327\231\327\225\327\252.\n   - \327\233\327\244\327\252\327\225\327\250 \327\241\327\231\327\225\327\235 \327\221\327\231\327\251\327\225\327\234 (\"\327\241\327\231\327\231\327\236\327\252\327\231 \327\234\327\221\327\251\327\234 - \327\242\327\223\327\233\327\237 \327\236\327\234\327\220\327\231\"): \327\234\327\227\327\231\327\246\327\224 \327\242\327\234\327\231\327\225 \327\222\327\225\327\250\327\242\327\252 \327\221\327\234\327\227\327\231\327\246\327\224 \327\220\327\227\327\252 \327\220\327\252 \327\224\327\220\327\250\327\231\327\226\327\225\327\252/\327\224\327\231\327\227\327\231\327\223\327\225\327\252 \327\251\327\224\327\231\327\225 \327\221\327\251\327\231\327\236\327\225\327\251 \327\236\327\252\327\225\327\232 \327\224\327\236\327\234\327\220\327\231 \327\224\327\247\327\231\327\231\327\235.\n\n3. \327\242\327\240\327\243 \327\247\327\240\327\231\327\225\327\252 (\327\252\327\246\327\225\327\222\327\252 \327\236\327\241\327\232 \327\236\327\244\327\225\327\246\327\234 / \327\246\327\223-\327\234\327\246\327\223):\n   - \327\227\327\234\327\247 \327\220\327\252 \327\236\327\241\327\232 \327\224\327\247\327\240\327\231\327\225\327\252 \327\234\327\251\327\240\327\231 \327\220\327\226\327\225\327\250\327\231\327\235 \327\221\327\250\327\225\327\250\327\231\327\235 (Side-by-Side \327\220\327\225 Split View):\n     \342\200\242 \327\246\327\223 \327\231\327\236\327\231\327\237 / \327\236\327\250\327\233\327\226\327\231: \327\246\'\327\247\327\234\327\231\327\241\327\230 \327\224\327\247\327\240\327\231\327\225\327\252 \327\224\327\244\327\242\327\231\327\234 (\327\250\327\251\327\231\327\236\327\252 \327\224\327\227\327\225\327\241\327\250\327\231\327\235 \327\251\327\240\327\225\327\246\327\250\327\224 \327\236\327\224\327\221\327\231\327\251\327\225\327\234\327\231\327\235 \327\220\327\225 \327\236\327\224\327\236\327\234\327\220\327\231 \327\251\327\224\327\252\327\250\327\225\327\247\327\237) \327\242\327\235 \327\233\327\244\327\252\327\225\327\250\327\231 \327\241\327\231\327\236\327\225\327\237 V, \327\242\327\250\327\231\327\233\327\224, \327\225\327\236\327\227\327\231\327\250 \327\236\327\246\327\230\327\221\327\250.\n     \342\200\242 \327\246\327\223 \327\251\327\236\327\220\327\234 / \327\252\327\227\327\252\327\225\327\237 (\327\225\327\225\327\231\327\223\327\222\'\327\230 \327\236\327\246\327\221 \327\236\327\234\327\220\327\231 \327\251\327\247\327\230): \327\252\327\246\327\225\327\222\327\224 \327\236\327\247\327\225\327\246\327\250\327\252 \327\251\327\234 \327\236\327\246\327\221 \327\224\327\236\327\234\327\220\327\231 \327\224\327\247\327\231\327\231\327\235 \327\221\327\236\327\226\327\225\327\225\327\224 (\327\234\327\244\327\231 \327\247\327\230\327\222\327\225\327\250\327\231\327\225\327\252), \327\233\327\223\327\231 \327\251\327\240\327\231\327\252\327\237 \327\231\327\224\327\231\327\224 \327\234\327\224\327\246\327\231\327\245 \327\221\327\236\327\224 \327\251\327\231\327\251 \327\221\327\221\327\231\327\252 \327\252\327\225\327\232 \327\233\327\223\327\231 \327\242\327\250\327\231\327\233\327\252 \327\224\327\250\327\251\327\231\327\236\327\224 \327\221\327\234\327\231 \327\234\327\242\327\221\327\225\327\250 \327\236\327\241\327\233\327\231\327\235.\n\n\327\251\327\236\327\225\327\250 \327\242\327\234 \327\236\327\236\327\251\327\247 RTL \327\242\327\221\327\250\327\231 \327\240\327\247\327\231, \327\236\327\224\327\231\327\250 \327\225\327\220\327\231\327\240\327\230\327\225\327\220\327\231\327\230\327\231\327\221\327\231."
    items {
      text: "\327\242\327\223\327\233\327\237 \327\220\327\252 \327\224\327\220\327\244\327\234\327\231\327\247\327\246\327\231\327\224 \327\234\327\244\327\231 \327\250\327\251\327\231\327\236\327\252 \327\224\327\252\327\231\327\247\327\225\327\240\327\231\327\235 \327\224\327\236\327\223\327\225\327\231\327\247\327\252 \327\224\327\221\327\220\327\224:\n\n1. \327\242\327\240\327\243 \327\236\327\234\327\220\327\231 (\327\233\327\250\327\230\327\231\327\241\327\231\327\225\327\252 \327\244\327\250\327\231\327\230 \327\225\327\231\327\227\327\231\327\223\327\225\327\252 \327\220\327\250\327\231\327\226\327\224):\n   - \327\231\327\227\327\231\327\223\327\225\327\252 \327\236\327\231\327\223\327\224 \327\244\327\251\327\225\327\230\327\225\327\252: \327\224\327\236\327\234\327\220\327\231 \327\231\327\240\327\225\327\224\327\234 \327\220\327\232 \327\225\327\250\327\247 \327\234\327\244\327\231 \327\220\327\250\327\231\327\226\327\225\327\252/\327\231\327\227\327\231\327\223\327\225\327\252 (\327\234\327\236\327\251\327\234: \"1 \327\246\327\240\327\246\327\240\327\252\", \"2 \327\247\327\225\327\244\327\241\327\220\327\225\327\252\", \"1 \327\251\327\247\327\231\327\252\", \"3 \327\231\327\227\'\") \342\200\224 \327\234\327\234\327\220 \327\227\327\231\327\251\327\225\327\221\327\231 \327\222\327\250\327\236\327\231\327\235 \327\220\327\225 \327\236\327\251\327\247\327\234\327\231\327\235 \327\236\327\225\327\250\327\233\327\221\327\231\327\235.\n   - \327\233\327\250\327\230\327\231\327\241\327\231\327\231\327\252 \327\244\327\250\327\231\327\230 \327\244\327\240\327\231\327\236\327\231\327\252 (Item Detail Modal / Drawer): \327\234\327\227\327\231\327\246\327\224 \327\242\327\234 \327\233\327\234 \327\244\327\250\327\231\327\230 \327\221\327\236\327\234\327\220\327\231 \327\244\327\225\327\252\327\227\327\252 \327\233\327\250\327\230\327\231\327\241\327\231\327\231\327\224 \327\231\327\231\327\242\327\225\327\223\327\231\327\252 \327\242\327\235:\n     \342\200\242 \327\251\327\235 \327\224\327\244\327\250\327\231\327\230 \327\225\327\224\327\241\327\234\327\225\327\230 \327\224\327\244\327\231\327\226\327\231 \327\251\327\234\327\225 \327\221\327\236\327\226\327\225\327\225\327\224.\n     \342\200\242 \327\233\327\236\327\225\327\252 \327\220\327\250\327\231\327\226\327\225\327\252 \327\240\327\225\327\233\327\227\327\231\327\252 \327\242\327\235 \327\233\327\244\327\252\327\225\327\250\327\231 \327\244\327\234\327\225\327\241/\327\236\327\231\327\240\327\225\327\241 \327\236\327\224\327\231\327\250\327\231\327\235 (+ / -).\n     \342\200\242 \327\241\327\230\327\230\327\225\327\241 \327\252\327\225\327\247\327\243 \327\220\327\225 \327\224\327\242\327\250\327\224 \327\247\327\246\327\250\327\224.\n     \342\200\242 \327\233\327\244\327\252\327\225\327\250 \327\236\327\224\327\231\327\250: \"\327\224\327\242\327\221\327\250 \327\234\327\227\327\225\327\241\327\250\327\231\327\235 \327\221\327\250\327\251\327\231\327\236\327\252 \327\247\327\240\327\231\327\225\327\252\".\n\n2. \327\242\327\240\327\243 \327\221\327\231\327\251\327\225\327\234 (\327\252\327\233\327\240\327\225\327\237, \327\244\327\231\327\250\327\225\327\247 \327\234\327\222\327\225\327\250\327\236\327\231\327\235 \327\225\327\222\327\250\327\231\327\242\327\224 \327\234\327\220\327\227\327\250 \327\221\327\231\327\246\327\225\327\242):\n   - \327\224\327\225\327\241\327\243 \327\220\327\226\327\225\327\250 \327\247\327\234\327\230 \327\236\327\224\327\231\327\250 (\327\252\327\231\327\221\327\252 \327\230\327\247\327\241\327\230 + \327\233\327\244\327\252\327\225\327\250 \327\224\327\247\327\234\327\230\327\224 \327\247\327\225\327\234\327\231\327\252) \327\234\327\224\327\226\327\240\327\252 \327\252\327\225\327\233\327\240\327\231\327\225\327\252 \327\224\327\221\327\231\327\251\327\225\327\234 (\327\234\327\223\327\225\327\222\327\236\327\224: \"\327\236\327\233\327\231\327\237 \327\236\327\225\327\247\327\244\327\245 \327\230\327\225\327\244\327\225 \327\225\327\247\327\231\327\251\327\225\327\220\327\231\327\235 \327\225\327\227\327\236\327\231\327\237 \327\221\327\225\327\250\327\222\327\225\327\234\").\n   - \327\240\327\231\327\252\327\225\327\227 \327\250\327\233\327\231\327\221\327\231\327\235 \327\236\327\225\327\234 \327\236\327\246\327\220\327\231: \327\224\327\236\327\242\327\250\327\233\327\252 \327\236\327\244\327\250\327\247\327\252 \327\220\327\252 \327\224\327\236\327\240\327\224 \327\234\327\250\327\233\327\231\327\221\327\231\327\235 \327\225\327\236\327\246\327\231\327\222\327\224 \327\241\327\230\327\230\327\225\327\241 \327\236\327\231\327\231\327\223\327\231 \327\234\327\233\327\234 \327\250\327\233\327\231\327\221:\n     \342\200\242 \342\234\205 \327\247\327\231\327\231\327\235 \327\221\327\236\327\234\327\220\327\231 (\327\220\327\231\327\226\327\225 \327\220\327\250\327\231\327\226\327\224/\327\241\327\234\327\225\327\230).\n     \342\200\242 \342\235\214 \327\227\327\241\327\250 \327\221\327\236\327\234\327\220\327\231 \342\200\224 \327\236\327\231\327\231\327\246\327\250 \327\220\327\225\327\230\327\225\327\236\327\230\327\231\327\252 \327\251\327\225\327\250\327\252 \327\244\327\250\327\231\327\230 \327\221\327\242\327\240\327\243 \327\224\327\247\327\240\327\231\327\225\327\252.\n   - \327\233\327\244\327\252\327\225\327\250 \327\241\327\231\327\225\327\235 \327\221\327\231\327\251\327\225\327\234 (\"\327\241\327\231\327\231\327\236\327\252\327\231 \327\234\327\221\327\251\327\234 - \327\242\327\223\327\233\327\237 \327\236\327\234\327\220\327\231\"): \327\234\327\227\327\231\327\246\327\224 \327\242\327\234\327\231\327\225 \327\222\327\225\327\250\327\242\327\252 \327\221\327\234\327\227\327\231\327\246\327\224 \327\220\327\227\327\252 \327\220\327\252 \327\224\327\220\327\250\327\231\327\226\327\225\327\252/\327\224\327\231\327\227\327\231\327\223\327\225\327\252 \327\251\327\224\327\231\327\225 \327\221\327\251\327\231\327\236\327\225\327\251 \327\236\327\252\327\225\327\232 \327\224\327\236\327\234\327\220\327\231 \327\224\327\247\327\231\327\231\327\235.\n\n3. \327\242\327\240\327\243 \327\247\327\240\327\231\327\225\327\252 (\327\252\327\246\327\225\327\222\327\252 \327\236\327\241\327\232 \327\236\327\244\327\225\327\246\327\234 / \327\246\327\223-\327\234\327\246\327\223):\n   - \327\227\327\234\327\247 \327\220\327\252 \327\236\327\241\327\232 \327\224\327\247\327\240\327\231\327\225\327\252 \327\234\327\251\327\240\327\231 \327\220\327\226\327\225\327\250\327\231\327\235 \327\221\327\250\327\225\327\250\327\231\327\235 (Side-by-Side \327\220\327\225 Split View):\n     \342\200\242 \327\246\327\223 \327\231\327\236\327\231\327\237 / \327\236\327\250\327\233\327\226\327\231: \327\246\'\327\247\327\234\327\231\327\241\327\230 \327\224\327\247\327\240\327\231\327\225\327\252 \327\224\327\244\327\242\327\231\327\234 (\327\250\327\251\327\231\327\236\327\252 \327\224\327\227\327\225\327\241\327\250\327\231\327\235 \327\251\327\240\327\225\327\246\327\250\327\224 \327\236\327\224\327\221\327\231\327\251\327\225\327\234\327\231\327\235 \327\220\327\225 \327\236\327\224\327\236\327\234\327\220\327\231 \327\251\327\224\327\252\327\250\327\225\327\247\327\237) \327\242\327\235 \327\233\327\244\327\252\327\225\327\250\327\231 \327\241\327\231\327\236\327\225\327\237 V, \327\242\327\250\327\231\327\233\327\224, \327\225\327\236\327\227\327\231\327\250 \327\236\327\246\327\230\327\221\327\250.\n     \342\200\242 \327\246\327\223 \327\251\327\236\327\220\327\234 / \327\252\327\227\327\252\327\225\327\237 (\327\225\327\225\327\231\327\223\327\222\'\327\230 \327\236\327\246\327\221 \327\236\327\234\327\220\327\231 \327\251\327\247\327\230): \327\252\327\246\327\225\327\222\327\224 \327\236\327\247\327\225\327\246\327\250\327\252 \327\251\327\234 \327\236\327\246\327\221 \327\224\327\236\327\234\327\220\327\231 \327\224\327\247\327\231\327\231\327\235 \327\221\327\236\327\226\327\225\327\225\327\224 (\327\234\327\244\327\231 \327\247\327\230\327\222\327\225\327\250\327\231\327\225\327\252), \327\233\327\223\327\231 \327\251\327\240\327\231\327\252\327\237 \327\231\327\224\327\231\327\224 \327\234\327\224\327\246\327\231\327\245 \327\221\327\236\327\224 \327\251\327\231\327\251 \327\221\327\221\327\231\327\252 \327\252\327\225\327\232 \327\233\327\223\327\231 \327\242\327\250\327\231\327\233\327\252 \327\224\327\250\327\251\327\231\327\236\327\224 \327\221\327\234\327\231 \327\234\327\242\327\221\327\225\327\250 \327\236\327\241\327\233\327\231\327\235.\n\n\327\251\327\236\327\225\327\250 \327\242\327\234 \327\236\327\236\327\251\327\247 RTL \327\242\327\221\327\250\327\231 \327\240\327\247\327\231, \327\236\327\224\327\231\327\250 \327\225\327\220\327\231\327\240\327\230\327\225\327\220\327\231\327\230\327\231\327\221\327\231."
