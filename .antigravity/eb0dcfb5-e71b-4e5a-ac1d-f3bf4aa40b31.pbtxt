34 \327\244\327\242\327\225\327\234\327\252 \327\224\327\225\327\241\327\244\327\252 \327\236\327\225\327\246\327\250, \327\242\327\223\327\233\327\225\327\237 \327\233\327\236\327\225\327\252, \327\251\327\231\327\240\327\225\327\231 \327\241\327\230\327\230\327\225\327\241 \327\241\327\234\327\225\327\230 \327\220\327\225 \327\241\327\240\327\233\327\250\327\225\327\237 \327\250\327\251\327\231\327\236\327\252 \327\247\327\240\327\231\327\225\327\252 \327\240\327\250\327\251\327\236\327\231\327\235 \327\252\327\227\327\252 \327\224-`user_id` \327\224\327\244\327\242\327\231\327\234.\n\n---\n\n### 3. \327\227\327\231\327\225\327\225\327\231 \327\236\327\251\327\252\327\236\327\251 \327\225\327\233\327\244\327\252\327\225\327\250 \327\224\327\252\327\240\327\252\327\247\327\225\327\252 \327\221\327\244\327\231\327\240\327\224 \327\224\327\242\327\234\327\231\327\225\327\240\327\224\n- **\327\252\327\246\327\225\327\222\327\252 \327\224\327\236\327\251\327\252\327\236\327\251 \327\221-Navbar**:\n  - \327\220\327\225\327\225\327\230\327\220\327\250 \327\242\327\235 \327\224\327\220\327\225\327\252 \327\224\327\250\327\220\327\251\327\225\327\240\327\224 \327\251\327\234 \327\224\327\236\327\251\327\252\327\236\327\251.\n  - \327\233\327\252\327\225\327\221\327\252 \327\224\327\223\327\225\327\220\"\327\234 \327\224\327\236\327\234\327\220\327\224 \327\225\327\252\327\222 \327\231\327\250\327\225\327\247 \"\327\236\327\227\327\225\327\221\327\250 \327\234\327\242\327\240\327\237\".\n  - \327\233\327\244\327\252\327\225\327\250 **\"\327\224\327\252\327\240\327\252\327\247\"** (Logout) \327\221\327\225\327\234\327\230 \327\242\327\235 \327\220\327\231\327\231\327\247\327\225\327\237.\n- **\327\224\327\252\327\240\327\252\327\247\327\225\327\252 \327\236\327\231\327\231\327\223\327\231\327\252**: \327\234\327\227\327\231\327\246\327\224 \327\242\327\234 \"\327\224\327\252\327\240\327\252\327\247\" \327\236\327\221\327\246\327\242\327\252 `signOutUser()` \327\236\327\225\3