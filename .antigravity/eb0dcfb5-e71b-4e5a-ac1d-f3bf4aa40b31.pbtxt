    replacement_chunks {
      replacement_content: "import React, { useState } from \'react\';\nimport { usePantry } from \'../context/PantryContext\';\nimport { PHYSICAL_SLOTS } from \'../data/slotDefinitions\';\nimport { SlotType, PantryItem } from \'../types\';\nimport { ItemDetailModal } from \'./ItemDetailModal\';\nimport {\n  Plus,\n  Minus,\n  AlertTriangle,\n  CheckCircle2,\n  XCircle,\n  Package,\n  Layers,\n  Calendar,\n  Sparkles,\n  ShoppingBag,\n  ExternalLink,\n  ChevronLeft,\n} from \'lucide-react\';\n\nexport const PhysicalRackView: React.FC<{ onOpenStockModal: () => void }> = ({ onOpenStockModal }) => {\n  const {\n    inventory,\n    quickStockChange,\n    selectedSlotFilter,\n    setSelectedSlotFilter,\n    searchQuery,\n    addShoppingItem,\n  } = usePantry();\n\n  const [viewMode, setViewMode] = useState<\'SLOTS\' | \'LIST\'>(\'SLOTS\');\n  const [selectedItemForDetail, setSelectedItemForDetail] = useState<PantryItem | null>(null);\n\n  // Filter items\n  const filteredItems = inventory.filter((item) => {\n    const matchesSlot = selectedSlotFilter === \'ALL\' || item.slot === selectedSlotFilter;\n    const matchesQuery =\n      searchQuery.trim() === \'\' ||\n      item.name.toLowerCase().includes(searchQuery.toLowerCase()) ||\n      (item.barcode_or_sku && item.barcode_or_sku.includes(searchQuery)) ||\n      PHYSICAL_SLOTS[item.slot]?.nameHe.toLowerCase().includes(searchQuery.toLowerCase());\n    return matchesSlot && matchesQuery;\n  });\n\n  // Keep selected item synced with updated inventory state\n  const currentDetailItem = selectedItemForDetail\n    ? inventory.find((i) => i.id === selectedItemForDetail.id) || null\n    : null;\n\n  // Stats\n  const totalItems = inventory.length;\n  const inStockCount = inventory.filter((i) => i.status === \'IN_STOCK\').length;\n  const lowCount = inventory.filter((i) => i.status === \'LOW\').length;\n  const emptyCount = inventory.filter((i) => i.status === \'EMPTY\').length;\n  const totalValuation = inventory.reduce((sum, item) => sum + (item.pricePerUnit || 0) * item.quantity, 0);\n\n  const slotKeys = Object.keys(PHYSICAL_SLOTS) as SlotType[];\n\n  const handleOpenDetail = (item: PantryItem, e?: React.MouseEvent) => {\n    e?.stopPropagation();\n    setSelectedItemForDetail(item);\n  };\n\n  return (\n    <div className=\"space-y-6\">\n      {/* Overview Metric Cards */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n        <div className=\"bg-white dark:bg-zinc-800/80 p-4 rounded-2xl border border-zinc-200 dark:border-zinc-700/80 shadow-xs\">\n          <div className=\"text-xs text-zinc-500 dark:text-zinc-400 font-medium\">\327\241\327\224\327\264\327\233 \327\244\327\250\327\231\327\230\327\231\327\235 \327\236\327\240\327\225\327\224\327\234\327\231\327\235</div>\n          <div className=\"text-2xl font-extrabold text-zinc-900 dark:text-white mt-1\">{totalItems}</div>\n          <div className=\"text-xs text-zinc-400 mt-1 flex items-center gap-1\">\n            <Layers className=\"w-3 h-3 text-emerald-500\" />\n            <span>\327\221-7 \327\241\327\234\327\225\327\230\327\231\327\235 \327\244\327\231\327\226\327\231\327\231\327\235</span>\n          </div>\n        </div>\n\n        <div className=\"bg-white dark:bg-zinc-800/80 p-4 rounded-2xl border border-zinc-200 dark:border-zinc-700/80 shadow-xs\">\n          <div className=\"text-xs text-emerald-600 dark:text-emerald-400 font-medium\">\327\226\327\236\327\231\327\240\327\231\327\235 \327\221\327\236\327\226\327\225\327\225\327\224 (\327\252\327\247\327\231\327\237)</div>\n          <div className=\"text-2xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-1\">{inStockCount}</div>\n          <div className=\"text-xs text-zinc-400 mt-1 flex items-center gap-1\">\n            <CheckCircle2 className=\"w-3 h-3 text-emerald-500\" />\n            <span>\327\236\327\234\327\220\327\231 \327\236\327\241\327\244\327\247 \327\234\327\221\327\231\327\251\327\225\327\234</span>\n          </div>\n        </div>\n\n        <div className=\"bg-white dark:bg-zinc-800/80 p-4 rounded-2xl border border-zinc-200 dark:border-zinc-700/80 shadow-xs\">\n          <div className=\"text-xs text-amber-600 dark:text-amber-400 font-medium\">\327\233\327\236\327\225\327\252 \327\240\327\236\327\225\327\233\327\224 (LOW)</div>\n          <div className=\"text-2xl font-extrabold text-amber-600 dark:text-amber-400 mt-1\">{lowCount}</div>\n          <div className=\"text-xs text-zinc-400 mt-1 flex items-center gap-1\">\n            <AlertTriangle className=\"w-3 h-3 text-amber-500\" />\n            <span>\327\236\327\252\327\227\327\252 \327\234\327\241\327\243 \327\224\327\236\327\231\327\240\327\231\327\236\327\225\327\235</span>\n          </div>\n        </div>\n\n        <div className=\"bg-white dark:bg-zinc-800/80 p-4 rounded-2xl border border-zinc-200 dark:border-zinc-700/80 shadow-xs\">\n          <div className=\"text-xs text-rose-600 dark:text-rose-400 font-medium\">\327\220\327\226\327\234\327\225 \327\234\327\227\327\234\327\225\327\230\327\231\327\237 (EMPTY)</div>\n          <div className=\"text-2xl font-extrabold text-rose-600 dark:text-rose-400 mt-1\">{emptyCount}</div>\n          <div className=\"text-xs text-zinc-400 mt-1 flex items-center gap-1\">\n            <XCircle className=\"w-3 h-3 text-rose-500\" />\n            <span>\327\251\327\225\327\225\327\231 \327\236\327\234\327\220\327\231: \342\202\252{totalValuation.toFixed(0)}</span>\n          </div>\n        </div>\n      </div>\n\n      {/* Slot Filter Bar */}\n      <div className=\"flex flex-col sm:flex-row sm:items-center justify-between gap-3 bg-white dark:bg-zinc-800/60 p-3 rounded-2xl border border-zinc-200 dark:border-zinc-700/80\">\n        <div className=\"flex items-center gap-1.5 overflow-x-auto no-scrollbar py-1\">\n          <button\n            onClick={() => setSelectedSlotFilter(\'ALL\')}\n            className={`px-3 py-1.5 text-xs font-semibold rounded-xl whitespace-nowrap transition-colors ${\n              selectedSlotFilter === \'ALL\'\n                ? \'bg-zinc-900 text-white dark:bg-white dark:text-zinc-900 shadow-xs\'\n                : \'bg-zinc-100 text-zinc-600 hover:bg-zinc-200 dark:bg-zinc-700 dark:text-zinc-300\'\n            }`}\n          >\n            \327\233\327\234 \327\224\327\241\327\234\327\225\327\230\327\231\327\235 ({inventory.length})\n          </button>\n          {slotKeys.map((key) => {\n            const slotMeta = PHYSICAL_SLOTS[key];\n            const count = inventory.filter((i) => i.slot === key).length;\n            const hasShortage = inventory.some((i) => i.slot === key && (i.status === \'EMPTY\' || i.status === \'LOW\'));\n            return (\n              <button\n                key={key}\n                onClick={() => setSelectedSlotFilter(key)}\n                className={`px-3 py-1.5 text-xs font-medium rounded-xl whitespace-nowrap flex items-center gap-1.5 transition-all border ${\n                  selectedSlotFilter === key\n                    ? \'bg-emerald-600 text-white border-emerald-600 shadow-xs\'\n                    : \'bg-zinc-50 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 border-zinc-200 dark:border-zinc-700 hover:bg-zinc-100\'\n                }`}\n              >\n                <span>{slotMeta.shortName}</span>\n                <span className=\"opacity-75 font-mono text-[11px]\">({count})</span>\n                {hasShortage && (\n                  <span className=\"w-1.5 h-1.5 rounded-full bg-amber-400 animate-pulse\" />\n                )}\n              </button>\n            );\n          })}\n        </div>\n\n        <div className=\"flex items-center gap-2 self-end sm:self-auto\">\n          <div className=\"flex items-center bg-zinc-100 dark:bg-zinc-700/60 p-0.5 rounded-xl text-xs\">\n            <button\n              onClick={() => setViewMode(\'SLOTS\')}\n              className={`px-3 py-1.5 rounded-lg font-medium transition-all ${\n                viewMode === \'SLOTS\' ? \'bg-white dark:bg-zinc-800 shadow-xs text-zinc-900 dark:text-white\' : \'text-zinc-500\'\n              }`}\n            >\n              \327\236\327\221\327\240\327\224 \327\236\327\226\327\225\327\225\327\224\n            </button>\n            <button\n              onClick={() => setViewMode(\'LIST\')}\n              className={`px-3 py-1.5 rounded-lg font-medium transition-all ${\n                viewMode === \'LIST\' ? \'bg-white dark:bg-zinc-800 shadow-xs text-zinc-900 dark:text-white\' : \'text-zinc-500\'\n              }`}\n            >\n              \327\250\327\251\327\231\327\236\327\224 \327\236\327\224\327\231\327\250\327\224\n            </button>\n          </div>\n        </div>\n      </div>\n\n      {/* Main Physical Rack / Slot View */}\n      {viewMode === \'SLOTS\' ? (\n        <div className=\"space-y-6\">\n          {slotKeys\n            .filter((key) => selectedSlotFilter === \'ALL\' || selectedSlotFilter === key)\n            .map((slotKey) => {\n              const slotMeta = PHYSICAL_SLOTS[slotKey];\n              const itemsInSlot = filteredItems.filter((i) => i.slot === slotKey);\n\n              return (\n                <div\n                  key={slotKey}\n                  id={`slot-section-${slotKey}`}\n                  className=\"bg-white dark:bg-zinc-800/90 rounded-2xl border border-zinc-200 dark:border-zinc-700 shadow-xs overflow-hidden\"\n                >\n                  {/* Slot Header */}\n                  <div className={`p-4 border-b border-zinc-200 dark:border-zinc-700/80 flex flex-wrap items-center justify-between gap-2 ${slotMeta.colorBg}`}>\n                    <div className=\"flex items-center gap-2.5\">\n                      <div className={`w-9 h-9 rounded-xl flex items-center justify-center font-bold text-sm bg-white dark:bg-zinc-800 border ${slotMeta.colorBorder} ${slotMeta.colorAccent}`}>\n                        {slotMeta.badge}\n                      </div>\n                      <div>\n                        <h3 className=\"font-bold text-base text-zinc-900 dark:text-white\">\n                          {slotMeta.nameHe}\n                        </h3>\n                        <p className=\"text-xs text-zinc-600 dark:text-zinc-400\">\n                          {slotMeta.descriptionHe}\n                        </p>\n                      </div>\n                    </div>\n\n                    <div className=\"flex items-center gap-2\">\n                      <span className=\"text-xs px-2.5 py-1 rounded-lg bg-white/80 dark:bg-zinc-800/80 text-zinc-700 dark:text-zinc-300 font-medium border border-zinc-200 dark:border-zinc-700\">\n                        {itemsInSlot.length} \327\244\327\250\327\231\327\230\327\231\327\235 \327\221\327\241\327\234\327\225\327\230\n                      </span>\n                    </div>\n                  </div>\n\n                  {/* Slot Items Grid */}\n                  <div className=\"p-4\">\n                    {itemsInSlot.length === 0 ? (\n                      <div className=\"text-center py-6 text-zinc-400 text-xs\">\n                        \327\220\327\231\327\237 \327\244\327\250\327\231\327\230\327\231\327\235 \327\221\327\241\327\234\327\225\327\230 \327\226\327\224 \327\233\327\250\327\222\327\242\n                      </div>\n                    ) : (\n                      <div className=\"grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-3\">\n                        {itemsInSlot.map((item) => (\n                          <div\n                            key={item.id}\n                            id={`item-card-${item.id}`}\n                            onClick={() => handleOpenDetail(item)}\n                            className={`p-3.5 rounded-2xl border transition-all cursor-pointer hover:shadow-md hover:border-emerald-500/50 group relative ${\n                              item.status === \'EMPTY\'\n                                ? \'bg-rose-50/50 dark:bg-rose-950/20 border-rose-200 dark:border-rose-900/50\'\n                                : item.status === \'LOW\'\n                                ? \'bg-amber-50/40 dark:bg-amber-950/20 border-amber-200 dark:border-amber-900/50\'\n                                : \'bg-zinc-50/70 dark:bg-zinc-800/50 border-zinc-200/80 dark:border-zinc-700/60\'\n                            }`}\n                          >\n                            {/* Card Top */}\n                            <div className=\"flex items-start justify-between gap-2\">\n                              <div className=\"flex-1 min-w-0\">\n                                <div className=\"flex items-center gap-1.5\">\n                                  <span\n                                    className={`w-2 h-2 rounded-full shrink-0 ${\n                                      item.status === \'IN_STOCK\'\n                                        ? \'bg-emerald-500\'\n                                        : item.status === \'LOW\'\n                                        ? \'bg-amber-500 animate-pulse\'\n                                        : \'bg-rose-500\'\n                                    }`}\n                                  />\n                                  <h4 className=\"font-bold text-sm text-zinc-900 dark:text-white truncate group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors\">\n                                    {item.name}\n                                  </h4>\n                                </div>\n                                <div className=\"text-[11px] text-zinc-500 dark:text-zinc-400 mt-1 flex items-center gap-2\">\n                                  {item.barcode_or_sku ? (\n                                    <span className=\"font-mono bg-zinc-200/70 dark:bg-zinc-700/60 px-1.5 py-0.2 rounded text-[10px]\">\n                                      {item.barcode_or_sku}\n                                    </span>\n                                  ) : (\n                                    <span>\327\234\327\234\327\220 \327\221\327\250\327\247\327\225\327\223</span>\n                                  )}\n                                  {item.expiryDate && (\n                                    <span className=\"flex items-center gap-0.5 text-zinc-400\">\n                                      <Calendar className=\"w-2.5 h-2.5\" />\n                                      {item.expiryDate}\n                                    </span>\n                                  )}\n                                </div>\n                              </div>\n\n                              <span\n                                className={`text-[10px] px-2 py-0.5 rounded-lg font-bold shrink-0 ${\n                                  item.status === \'IN_STOCK\'\n                                    ? \'bg-emerald-100 text-emerald-800 dark:bg-emerald-950/60 dark:text-emerald-300\'\n                                    : item.status === \'LOW\'\n                                    ? \'bg-amber-100 text-amber-800 dark:bg-amber-950/60 dark:text-amber-300\'\n                                    : \'bg-rose-100 text-rose-800 dark:bg-rose-950/60 dark:text-rose-300\'\n                                THREE}`}\n                              >\n                                {item.status === \'IN_STOCK\' ? \'\327\226\327\236\327\231\327\237\' : item.status === \'LOW\' ? \'\327\240\327\236\327\225\327\232\' : \'\327\220\327\226\327\234\'}\n                              </span>\n                            </div>\n\n                            {/* Quantity & Stepper (Strictly Packaging Units) */}\n                            <div className=\"flex items-center justify-between mt-3 pt-2.5 border-t border-zinc-200/60 dark:border-zinc-700/50\">\n                              <div className=\"flex items-baseline gap-1\">\n                                <span className=\"text-xl font-extrabold font-mono text-zinc-900 dark:text-white\">\n                                  {item.quantity}\n                                </span>\n                                <span className=\"text-xs text-zinc-600 dark:text-zinc-300 font-semibold\">{item.unit}</span>\n                                {item.minThreshold > 0 && (\n                                  <span className=\"text-[10px] text-zinc-400 mr-1\">\n                                    (\327\241\327\243: {item.minThreshold})\n                                  </span>\n                                )}\n                              </div>\n\n                              {/* Stepper Buttons */}\n                              <div className=\"flex items-center gap-1\" onClick={(e) => e.stopPropagation()}>\n                                <button\n                                  onClick={() => quickStockChange(item.id, -1)}\n                                  disabled={item.quantity <= 0}\n                                  id={`btn-minus-${item.id}`}\n                                  title=\"\327\222\327\250\327\242 \327\220\327\250\327\231\327\226\327\224 \327\220\327\227\327\252 (-1)\"\n                                  className=\"w-7 h-7 rounded-lg bg-zinc-200/80 dark:bg-zinc-700 text-zinc-700 dark:text-zinc-200 flex items-center justify-center hover:bg-zinc-300 active:scale-95 disabled:opacity-30 disabled:cursor-not-allowed transition-all\"\n                                >\n                                  <Minus className=\"w-3.5 h-3.5\" />\n                                </button>\n                                <button\n                                  onClick={() => quickStockChange(item.id, 1)}\n                                  id={`btn-plus-${item.id}`}\n                                  title=\"\327\224\327\225\327\241\327\243 \327\220\327\250\327\231\327\226\327\224 \327\220\327\227\327\252 (+1)\"\n                                  className=\"w-7 h-7 rounded-lg bg-emerald-600 text-white flex items-center justify-center hover:bg-emerald-700 active:scale-95 transition-all shadow-xs\"\n                                >\n                                  <Plus className=\"w-3.5 h-3.5\" />\n                                </button>\n                              </div>\n                            </div>\n\n                            {/* Card Footer Hint: Open Drawer */}\n                            <div className=\"mt-2 flex items-center justify-between text-[10px] text-zinc-400 group-hover:text-emerald-600 dark:group-hover:text-emerald-400 transition-colors\">\n                              <span className=\"truncate\">{item.notes || \'\327\234\327\227\327\245 \327\234\327\244\327\252\327\231\327\227\327\252 \327\233\327\250\327\230\327\231\327\241\327\231\327\231\327\252 \327\244\327\250\327\231\327\230 \327\225\327\244\327\242\327\225\327\234\327\225\327\252\'}</span>\n                              <ChevronLeft className=\"w-3 h-3 shrink-0 transform group-hover:-translate-x-0.5 transition-transform\" />\n                            </div>\n                          </div>\n                        ))}\n                      </div>\n                    )}\n                  </div>\n                </div>\n              );\n            })}\n        </div>\n      ) : (\n        /* Flat List View */\n        <div className=\"bg-white dark:bg-zinc-800 rounded-2xl border border-zinc-200 dark:border-zinc-700 shadow-xs overflow-hidden\">\n          <div className=\"divide-y divide-zinc-200 dark:divide-zinc-700\">\n            {filteredItems.map((item) => {\n              const slotMeta = PHYSICAL_SLOTS[item.slot];\n              return (\n                <div\n                  key={item.id}\n                  onClick={() => handleOpenDetail(item)}\n                  className=\"p-3.5 hover:bg-zinc-50 dark:hover:bg-zinc-700/50 flex items-center justify-between gap-3 cursor-pointer transition-colors\"\n                >\n                  <div className=\"flex items-center gap-3 min-w-0\">\n                    <span\n                      className={`w-2.5 h-2.5 rounded-full shrink-0 ${\n                        item.status === \'IN_STOCK\'\n                          ? \'bg-emerald-500\'\n                          : item.status === \'LOW\'\n                          ? \'bg-amber-500\'\n                          : \'bg-rose-500\'\n                      }`}\n                    />\n                    <div className=\"min-w-0\">\n                      <h4 className=\"font-bold text-sm text-zinc-900 dark:text-white truncate\">\n                        {item.name}\n                      </h4>\n                      <div className=\"text-xs text-zinc-400 flex items-center gap-2\">\n                        <span>{slotMeta.shortName}</span>\n                        <span>\342\200\242</span>\n                        <span>{item.department}</span>\n                        {item.notes && (\n                          <>\n                            <span>\342\200\242</span>\n                            <span className=\"text-zinc-500 italic truncate\">{item.notes}</span>\n                          </>\n                        )}\n                      </div>\n                    </div>\n                  </div>\n\n                  <div className=\"flex items-center gap-4 shrink-0\" onClick={(e) => e.stopPropagation()}>\n                    <div className=\"text-left\">\n                      <span className=\"font-extrabold font-mono text-base text-zinc-900 dark:text-white\">\n                        {item.quantity}\n                      </span>\n                      <span className=\"text-xs text-zinc-500 mr-1\">{item.unit}</span>\n                    </div>\n\n                    <div className=\"flex items-center gap-1\">\n                      <button\n                        onClick={() => quickStockChange(item.id, -1)}\n                        disabled={item.quantity <= 0}\n                        className=\"w-7 h-7 rounded-lg bg-zinc-100 dark:bg-zinc-700 text-zinc-700 dark:text-zinc-200 flex items-center justify-center hover:bg-zinc-200 disabled:opacity-30\"\n                      >\n                        <Minus className=\"w-3.5 h-3.5\" />\n                      </button>\n                      <button\n                        onClick={() => quickStockChange(item.id, 1)}\n                        className=\"w-7 h-7 rounded-lg bg-emerald-600 text-white flex items-center justify-center hover:bg-emerald-700\"\n                      >\n                        <Plus className=\"w-3.5 h-3.5\" />\n                      </button>\n                    </div>\n\n                    <button\n                      onClick={() => handleOpenDetail(item)}\n                      className=\"px-2.5 py-1 text-xs font-semibold rounded-lg bg-zinc-100 hover:bg-zinc-200 dark:bg-zinc-700 dark:hover:bg-zinc-600 text-zinc-700 dark:text-zinc-200 flex items-center gap-1\"\n                    >\n                      <span>\327\233\327\250\327\230\327\231\327\241\327\231\327\231\327\224</span>\n                      <ChevronLeft className=\"w-3 h-3\" />\n                    </button>\n                  </div>\n                </div>\n              );\n            })}\n          </div>\n        </div>\n      )}\n\n      {/* Item Detail Modal */}\n      <ItemDetailModal\n        item={currentDetailItem}\n        isOpen={Boolean(currentDetailItem)}\n        onClose={() => setSelectedItemForDetail(null)}\n      />\n    </div>\n  );\n};\n"
