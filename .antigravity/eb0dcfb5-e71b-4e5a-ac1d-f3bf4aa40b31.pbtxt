        target_content: "  return (\n    <div className=\"space-y-6\" dir=\"rtl\">\n      {/* ======================================================== */}\n      {/* 1. HERO PROMINENT ACTION CARD: ADD INVENTORY + RECEIPT OCR */}\n      {/* ======================================================== */}\n      <div className=\"relative overflow-hidden bg-gradient-to-r from-emerald-600 via-teal-600 to-emerald-700 rounded-3xl p-5 sm:p-6 text-white shadow-xl shadow-emerald-950/10 border border-emerald-500/30\">\n        <div className=\"relative z-10 flex flex-col md:flex-row items-start md:items-center justify-between gap-5\">\n          <div className=\"space-y-1.5 max-w-xl\">\n            <div className=\"inline-flex items-center gap-2 px-3 py-1 rounded-full bg-white/15 backdrop-blur-md text-xs font-bold text-emerald-100 border border-white/20\">\n              <Sparkles className=\"w-3.5 h-3.5 text-amber-300 animate-pulse\" />\n              <span>\327\236\327\250\327\233\327\226 \327\247\327\234\327\231\327\230\327\252 \327\236\327\234\327\220\327\231 \327\227\327\233\327\235 \327\234\327\236\327\226\327\225\327\225\327\224</span>\n            </div>\n            <h2 className=\"text-xl sm:text-2xl font-black text-white tracking-tight\">\n              \327\224\327\225\327\241\327\244\327\252 \327\244\327\250\327\231\327\230\327\231\327\235 \327\227\327\223\327\251\327\231\327\235 \327\225\327\241\327\231\327\225\327\225\327\222 \327\220\327\225\327\230\327\225\327\236\327\230\327\231 \327\234-7 \327\224\327\241\327\234\327\225\327\230\327\231\327\235\n            </h2>\n            <p className=\"text-xs sm:text-sm text-emerald-100/90 leading-relaxed\">\n              \327\224\327\226\327\237 \327\244\327\250\327\231\327\230 \327\221\327\225\327\223\327\223 \327\231\327\223\327\240\327\231\327\252, \327\224\327\242\327\234\327\224 \327\246\327\231\327\234\327\225\327\235 \327\251\327\234 \327\247\327\221\327\234\327\252 \327\241\327\225\327\244\327\250 \327\234-OCR \327\236\327\231\327\231\327\223\327\231, \327\220\327\225 \327\224\327\223\327\221\327\247 \327\250\327\251\327\231\327\236\327\252 \327\247\327\240\327\231\327\225\327\252 \327\234\327\227\327\231\327\234\327\225\327\245 \327\233\327\234 \327\224\327\236\327\225\327\246\327\250\327\231\327\235 \327\225\327\224\327\241\327\234\327\225\327\230\327\231\327\235 \327\221\327\236\327\233\327\224 \327\220\327\227\327\252.\n            </p>\n          </div>\n\n          <div className=\"flex flex-wrap items-center gap-2.5 w-full md:w-auto\">\n            {/* Primary Action 1: Full Modal Add (Manual / Wizard) */}\n            <button\n              onClick={() => {\n                setTargetSlotForAdd(selectedSlotFilter === \'ALL\' ? \'JAR_COLUMN_1\' : selectedSlotFilter);\n                setAddModalInitialMode(\'MANUAL\');\n                setIsAddModalOpen(true);\n              }}\n              id=\"hero-btn-add-item-manual\"\n              className=\"flex-1 md:flex-none px-4 py-3 bg-white text-emerald-800 hover:bg-emerald-50 active:bg-emerald-100 rounded-2xl font-bold text-xs sm:text-sm shadow-md flex items-center justify-center gap-2 transition-all transform active:scale-95\"\n            >\n              <PackagePlus className=\"w-5 h-5 text-emerald-600\" />\n              <span>\327\224\327\225\327\241\327\243 \327\244\327\250\327\231\327\230 \327\227\327\223\327\251</span>\n            </button>\n\n            {/* Primary Action 2: Receipt OCR Upload */}\n            <button\n              onClick={() => {\n                setTargetSlotForAdd(selectedSlotFilter === \'ALL\' ? \'JAR_COLUMN_1\' : selectedSlotFilter);\n                setAddModalInitialMode(\'RECEIPT_AI\');\n                setIsAddModalOpen(true);\n              }}\n              id=\"hero-btn-add-receipt-ocr\"\n              className=\"flex-1 md:flex-none px-4 py-3 bg-emerald-800/80 hover:bg-emerald-900 active:bg-black/30 text-white rounded-2xl font-bold text-xs sm:text-sm shadow-md border border-white/20 flex items-center justify-center gap-2 transition-all transform active:scale-95\"\n            >\n              <Upload className=\"w-4 h-4 text-amber-300\" />\n              <span>\327\224\327\242\327\234\327\224 \327\247\327\221\327\234\327\224 (OCR)</span>\n            </button>\n\n            {/* Primary Action 3: Shopping List Import */}\n            <button\n              onClick={() => {\n                setTargetSlotForAdd(selectedSlotFilter === \'ALL\' ? \'JAR_COLUMN_1\' : selectedSlotFilter);\n                setAddModalInitialMode(\'SHOPPING_LIST_AI\');\n                setIsAddModalOpen(true);\n              }}\n              id=\"hero-btn-add-shopping-list\"\n              className=\"px-3.5 py-3 bg-white/10 hover:bg-white/20 active:bg-white/30 text-white rounded-2xl font-medium text-xs border border-white/15 flex items-center justify-center gap-1.5 transition-all\"\n              title=\"\327\224\327\223\327\221\327\247 \327\250\327\251\327\231\327\236\327\252 \327\247\327\240\327\231\327\225\327\252 \327\234\327\227\327\231\327\234\327\225\327\245\"\n            >\n              <FileSpreadsheet className=\"w-4 h-4\" />\n              <span>\327\227\327\231\327\234\327\225\327\245 \327\236\327\250\327\251\327\231\327\236\327\224</span>\n            </button>\n          </div>\n        </div>\n\n        {/* Subtle decorative background circles */}\n        <div className=\"absolute -left-12 -bottom-12 w-48 h-48 bg-white/5 rounded-full blur-2xl pointer-events-none\" />\n        <div className=\"absolute -right-12 -top-12 w-48 h-48 bg-teal-400/10 rounded-full blur-2xl pointer-events-none\" />\n      </div>\n\n      {/* Overview Metric Cards */}\n      <div className=\"grid grid-cols-2 sm:grid-cols-4 gap-3\">\n        <div className=\"bg-white dark:bg-zinc-800/80 p-4 rounded-2xl border border-zinc-200 dark:border-zinc-700/80 shadow-xs\">\n          <div className=\"text-xs text-zinc-500 dark:text-zinc-400 font-medium\">\327\241\327\224\327\264\327\233 \327\244\327\250\327\231\327\230\327\231\327\235 \327\236\327\240\327\225\327\224\327\234\327\231\327\235</div>\n          <div className=\"text-2xl font-extrabold text-zinc-900 dark:text-white mt-1\">{totalItems}</div>\n          <div className=\"text-xs text-zinc-400 mt-1 flex items-center gap-1\">\n            <Layers className=\"w-3 h-3 text-emerald-500\" />\n            <span>\327\221-7 \327\241\327\234\327\225\327\230\327\231\327\235 \327\244\327\231\327\226\327\231\327\231\327\235</span>\n          </div>\n        </div>\n\n        <div className=\"bg-white dark:bg-zinc-800/80 p-4 rounded-2xl border border-zinc-200 dark:border-zinc-700/80 shadow-xs\">\n          <div className=\"text-xs text-emerald-600 dark:text-emerald-400 font-medium\">\327\226\327\236\327\231\327\240\327\231\327\235 \327\221\327\236\327\226\327\225\327\225\327\224 (\327\252\327\247\327\231\327\237)</div>\n          <div className=\"text-2xl font-extrabold text-emerald-600 dark:text-emerald-400 mt-1\">{inStockCount}</div>\n          <div className=\"text-xs text-zinc-400 mt-1 flex items-center gap-1\">\n            <CheckCircle2 className=\"w-3 h-3 text-emerald-500\" />\n            <span>\327\236\327\242\327\234 \327\250\327\243 \327\224\327\236\327\231\327\240\327\231\327\236\327\225\327\235</span>\n          </div>\n        </div>\n\n        <div className=\"bg-white dark:bg-zinc-800/80 p-4 rounded-2xl border border-zinc-200 dark:border-zinc-700/80 shadow-xs\">\n          <div className=\"text-xs text-amber-600 dark:text-amber-400 font-medium\">\327\233\327\236\327\225\327\252 \327\240\327\236\327\225\327\233\327\224 (LOW)</div>\n          <div className=\"text-2xl font-extrabold text-amber-600 dark:text-amber-400 mt-1\">{lowCount}</div>\n          <div className=\"text-xs text-zinc-400 mt-1 flex items-center gap-1\">\n            <AlertTriangle className=\"w-3 h-3 text-amber-500\" />\n            <span>\327\221\327\241\327\236\327\225\327\232 \327\220\327\225 \327\236\327\252\327