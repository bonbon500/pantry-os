          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        if (itemName.includes(\'\327\220\327\225\327\250\327\226\') || itemName.includes(\'\327\242\327\223\327\251\327\231\327\235\') || itemName.includes(\'\327\247\327\236\327\227\') || itemName.includes(\'\327\241\327\225\327\233\327\250\') || itemName.includes(\'\327\236\327\234\327\227\') || itemName.includes(\'\327\252\327\221\327\234\327\231\327\237\')) {"
